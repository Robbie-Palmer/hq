{
  "name": "personal-finance-api",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated Cloudflare Worker runtime for Personal Finance App",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "lint:api": "pnpm openapi:check && spectral lint openapi.json --ruleset .spectral.yaml --fail-severity error"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.14.0",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "^1.6.19",
    "cedar-authorization": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.7.11",
    "personal-finance-data": "workspace:*",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@stoplight/spectral-cli": "6.17.0",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4"
  }
}

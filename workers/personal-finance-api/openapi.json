{
  "openapi": "3.1.0",
  "info": {
    "title": "Personal Finance App API",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "health",
      "description": "Worker process health."
    },
    {
      "name": "canary",
      "description": "Synthetic authenticated runtime proof."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "The Worker process is accepting requests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/canary/household": {
      "put": {
        "operationId": "writeSyntheticHouseholdCanary",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "canary"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "enum": [
                      "synthetic household"
                    ]
                  }
                },
                "required": [
                  "label"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The synthetic household canary record.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "classification": {
                      "type": "string",
                      "enum": [
                        "synthetic-only"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "label": {
                      "type": "string",
                      "enum": [
                        "synthetic household"
                      ]
                    }
                  },
                  "required": [
                    "classification",
                    "id",
                    "label"
                  ]
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "readSyntheticHouseholdCanary",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "canary"
        ],
        "responses": {
          "200": {
            "description": "The synthetic household canary record.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "classification": {
                      "type": "string",
                      "enum": [
                        "synthetic-only"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "label": {
                      "type": "string",
                      "enum": [
                        "synthetic household"
                      ]
                    }
                  },
                  "required": [
                    "classification",
                    "id",
                    "label"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No synthetic household canary record exists."
          }
        }
      }
    }
  }
}

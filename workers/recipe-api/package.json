{
  "name": "recipe-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "bash scripts/test-integration.sh",
    "test:watch": "vitest",
    "db:check": "bash scripts/check-migrations.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "lint:api": "pnpm openapi:check && spectral lint openapi.json --ruleset .spectral.yaml --fail-severity error",
    "preview:seed": "tsx scripts/seed-preview.ts",
    "backfill:cookware": "tsx scripts/canonicalize-cookware.ts"
  },
  "dependencies": {
    "@better-auth/agent-auth": "0.6.2",
    "@hono/zod-openapi": "1.6.3",
    "agent-auth": "workspace:*",
    "better-auth": "^1.6.19",
    "better-auth-cloudflare": "^0.3.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.7.11",
    "ipaddr.js": "^2.4.0",
    "jose": "^6.1.3",
    "observability": "workspace:*",
    "postgres": "^3.4.5",
    "recipe-db": "workspace:*",
    "recipe-domain": "workspace:*",
    "recipe-parsing": "workspace:*",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@stoplight/spectral-cli": "6.16.3",
    "@stoplight/spectral-owasp-ruleset": "2.0.1",
    "@types/node": "^24",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.0",
    "node-base": "workspace:*",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "wrangler": "^4",
    "ws": "^8.18.3"
  }
}

{
  "components": {
    "schemas": {
      "Asset": {
        "additionalProperties": false,
        "properties": {
          "height": {
            "format": "int32",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Height",
            "type": "integer"
          },
          "id": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "source",
              "proposal",
              "reference"
            ],
            "title": "Kind",
            "type": "string"
          },
          "media_type": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ],
            "title": "Media Type",
            "type": "string"
          },
          "path": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "sha256": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "width": {
            "format": "int32",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "media_type",
          "sha256",
          "width",
          "height"
        ],
        "title": "Asset",
        "type": "object"
      },
      "BundleProvenance": {
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Dataset Id",
            "type": "string"
          },
          "dataset_revision": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Dataset Revision",
            "type": "string"
          },
          "derivation": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Derivation",
            "type": "string"
          },
          "producer": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Producer",
            "type": "string"
          },
          "producer_revision": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[a-f0-9]{64}$",
            "title": "Producer Revision",
            "type": "string"
          },
          "producer_version": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Producer Version",
            "type": "string"
          }
        },
        "required": [
          "producer",
          "producer_version",
          "producer_revision",
          "dataset_id",
          "dataset_revision",
          "derivation"
        ],
        "title": "BundleProvenance",
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "Error",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "Proposal": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Asset Id",
            "type": "string"
          },
          "id": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Id",
            "type": "string"
          },
          "model_license": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Model License",
            "type": "string"
          },
          "model_name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Model Name",
            "type": "string"
          },
          "model_revision": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Model Revision",
            "type": "string"
          },
          "role": {
            "enum": [
              "primary",
              "alternative",
              "baseline"
            ],
            "title": "Role",
            "type": "string"
          },
          "source_box_clipped": {
            "title": "Source Box Clipped",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "asset_id",
          "role",
          "model_name",
          "model_revision",
          "model_license",
          "source_box_clipped"
        ],
        "title": "Proposal",
        "type": "object"
      },
      "ReviewBundle": {
        "additionalProperties": false,
        "properties": {
          "assets": {
            "items": {
              "$ref": "#/components/schemas/Asset"
            },
            "maxItems": 100000,
            "minItems": 1,
            "title": "Assets",
            "type": "array"
          },
          "batch_id": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Batch Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "maxLength": 35,
            "title": "Created At",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReviewItem"
            },
            "maxItems": 100000,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "provenance": {
            "$ref": "#/components/schemas/BundleProvenance"
          },
          "schema_version": {
            "const": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "batch_id",
          "created_at",
          "provenance",
          "assets",
          "items"
        ],
        "title": "ReviewBundle",
        "type": "object"
      },
      "ReviewContext": {
        "additionalProperties": false,
        "properties": {
          "bbox_xyxy": {
            "items": {
              "format": "int32",
              "maximum": 2147483647.0,
              "minimum": 0.0,
              "type": "integer"
            },
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "format": "int32",
                "maximum": 2147483647.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "format": "int32",
                "maximum": 2147483647.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "format": "int32",
                "maximum": 2147483647.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "format": "int32",
                "maximum": 2147483647.0,
                "minimum": 0.0,
                "type": "integer"
              }
            ],
            "title": "Bbox Xyxy",
            "type": "array"
          },
          "class_name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Class Name",
            "type": "string"
          },
          "coordinate_space": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Coordinate Space",
            "type": "string"
          },
          "dataset_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Dataset Id",
            "type": "string"
          },
          "site_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Site Id",
            "type": "string"
          },
          "source_annotation_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Source Annotation Id",
            "type": "string"
          },
          "source_item_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Source Item Id",
            "type": "string"
          },
          "split": {
            "enum": [
              "train",
              "validation"
            ],
            "title": "Split",
            "type": "string"
          }
        },
        "required": [
          "dataset_id",
          "source_item_id",
          "source_annotation_id",
          "split",
          "site_id",
          "class_name",
          "bbox_xyxy",
          "coordinate_space"
        ],
        "title": "ReviewContext",
        "type": "object"
      },
      "ReviewEvent": {
        "additionalProperties": false,
        "properties": {
          "batch_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Batch Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "maxLength": 35,
            "title": "Created At",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "maxLength": 36,
            "title": "Event Id",
            "type": "string"
          },
          "item_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Item Id",
            "type": "string"
          },
          "mask_decision": {
            "enum": [
              "accept",
              "refine",
              "reject",
              "not_applicable"
            ],
            "title": "Mask Decision",
            "type": "string"
          },
          "notes": {
            "default": "",
            "maxLength": 4000,
            "title": "Notes",
            "type": "string"
          },
          "object_decision": {
            "enum": [
              "valid_nucleus",
              "non_nucleus",
              "uncertain"
            ],
            "title": "Object Decision",
            "type": "string"
          },
          "reviewer_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
            "title": "Reviewer Id",
            "type": "string"
          },
          "reviewer_kind": {
            "enum": [
              "human",
              "assistant"
            ],
            "title": "Reviewer Kind",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "selected_proposal_id": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Proposal Id"
          },
          "supersedes_event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "maxLength": 36,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Event Id"
          }
        },
        "required": [
          "schema_version",
          "event_id",
          "batch_id",
          "item_id",
          "reviewer_id",
          "reviewer_kind",
          "created_at",
          "object_decision",
          "mask_decision"
        ],
        "title": "ReviewEvent",
        "type": "object"
      },
      "ReviewItem": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/components/schemas/ReviewContext"
          },
          "id": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Id",
            "type": "string"
          },
          "proposals": {
            "items": {
              "$ref": "#/components/schemas/Proposal"
            },
            "maxItems": 16,
            "minItems": 1,
            "title": "Proposals",
            "type": "array"
          },
          "reference_asset_id": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Asset Id"
          },
          "source_asset_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Source Asset Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_asset_id",
          "proposals",
          "context"
        ],
        "title": "ReviewItem",
        "type": "object"
      },
      "ReviewSession": {
        "additionalProperties": false,
        "properties": {
          "bundle": {
            "$ref": "#/components/schemas/ReviewBundle"
          },
          "latest_reviews": {
            "items": {
              "$ref": "#/components/schemas/ReviewEvent"
            },
            "maxItems": 100000,
            "title": "Latest Reviews",
            "type": "array"
          }
        },
        "required": [
          "bundle",
          "latest_reviews"
        ],
        "title": "ReviewSession",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Pathologize"
    },
    "description": "Reads a versioned annotation-review bundle and appends reviewer events. The process binds only to loopback, RFC 1918, or tailnet addresses.",
    "summary": "Local and tailnet-only review API for versioned annotation bundles.",
    "title": "Annotation Workbench API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/assets/{asset_id}": {
      "get": {
        "description": "Returns one image only after bundle loading verifies its SHA-256 digest.",
        "operationId": "getReviewAsset",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Asset Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "image/jpeg": {
                "schema": {
                  "format": "binary",
                  "maxLength": 50000000,
                  "type": "string"
                }
              },
              "image/png": {
                "schema": {
                  "format": "binary",
                  "maxLength": 50000000,
                  "type": "string"
                }
              },
              "image/webp": {
                "schema": {
                  "format": "binary",
                  "maxLength": 50000000,
                  "type": "string"
                }
              }
            },
            "description": "The requested image asset."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The asset does not exist in this bundle."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The asset identifier does not satisfy the contract."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The asset could not be read."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No review bundle is loaded."
          }
        },
        "summary": "Read one digest-verified image asset",
        "tags": [
          "assets"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Returns a fixed response after the FastAPI process accepts the request.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The API could not complete the health check."
          }
        },
        "summary": "Check whether the API process is accepting requests",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/reviews": {
      "post": {
        "description": "Appends one immutable event after checking the bundle references and supersession chain.",
        "operationId": "createReviewEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewEvent"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The request has an invalid content length."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The event conflicts with the review history or bundle."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The event exceeds the size limit."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The event does not satisfy the review contract."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The review event could not be saved."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No review bundle is loaded."
          }
        },
        "summary": "Append a review event",
        "tags": [
          "reviews"
        ]
      }
    },
    "/api/v1/session": {
      "get": {
        "description": "Returns the pinned bundle plus the latest event for every item and reviewer pair.",
        "operationId": "getReviewSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewSession"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The session could not be read."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No review bundle is loaded."
          }
        },
        "summary": "Read the review bundle and each reviewer's latest event",
        "tags": [
          "reviews"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local or private-tailnet development server",
      "url": "/",
      "x-internal": true
    }
  ],
  "tags": [
    {
      "description": "Digest-verified review images.",
      "name": "assets"
    },
    {
      "description": "Process health.",
      "name": "health"
    },
    {
      "description": "Review sessions and append-only events.",
      "name": "reviews"
    }
  ]
}

{
  "$defs": {
    "AdapterSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "title": "Adapter Id",
          "type": "string"
        },
        "artifact_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Path"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "entrypoint": {
          "minLength": 1,
          "title": "Entrypoint",
          "type": "string"
        },
        "execution_device": {
          "$ref": "#/$defs/ExecutionDevice",
          "default": "cpu"
        },
        "kind": {
          "enum": [
            "builtin",
            "python_entrypoint"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "adapter_id",
        "kind",
        "entrypoint",
        "version"
      ],
      "title": "AdapterSpec",
      "type": "object"
    },
    "ExecutionDevice": {
      "enum": [
        "cpu",
        "accelerator"
      ],
      "title": "ExecutionDevice",
      "type": "string"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "title": "Gate",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "gate",
        "passed",
        "observed",
        "threshold"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "value",
        "unit",
        "role",
        "direction"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "ResourceUsage": {
      "additionalProperties": false,
      "properties": {
        "accelerator_wall_seconds": {
          "minimum": 0,
          "title": "Accelerator Wall Seconds",
          "type": "number"
        },
        "cpu_seconds": {
          "minimum": 0,
          "title": "Cpu Seconds",
          "type": "number"
        },
        "input_bytes": {
          "minimum": 0,
          "title": "Input Bytes",
          "type": "integer"
        },
        "input_pixels": {
          "minimum": 0,
          "title": "Input Pixels",
          "type": "integer"
        },
        "peak_accelerator_memory_bytes": {
          "minimum": 0,
          "title": "Peak Accelerator Memory Bytes",
          "type": "integer"
        },
        "peak_rss_bytes": {
          "minimum": 0,
          "title": "Peak Rss Bytes",
          "type": "integer"
        },
        "prediction_bytes": {
          "minimum": 0,
          "title": "Prediction Bytes",
          "type": "integer"
        },
        "samples": {
          "minimum": 0,
          "title": "Samples",
          "type": "integer"
        },
        "wall_seconds": {
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "samples",
        "input_bytes",
        "prediction_bytes",
        "input_pixels",
        "wall_seconds",
        "cpu_seconds",
        "peak_rss_bytes",
        "accelerator_wall_seconds",
        "peak_accelerator_memory_bytes"
      ],
      "title": "ResourceUsage",
      "type": "object"
    },
    "RunFailure": {
      "additionalProperties": false,
      "properties": {
        "error_type": {
          "title": "Error Type",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "error_type",
        "message"
      ],
      "title": "RunFailure",
      "type": "object"
    },
    "RunSummary": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterSpec"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/RunFailure"
          },
          "title": "Failures",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricResult"
          },
          "title": "Metrics",
          "type": "array"
        },
        "resources": {
          "$ref": "#/$defs/ResourceUsage"
        }
      },
      "required": [
        "adapter",
        "metrics",
        "resources",
        "failures"
      ],
      "title": "RunSummary",
      "type": "object"
    },
    "Workstream": {
      "enum": [
        "whole_slide_tissue_artifact_quality",
        "tiling_magnification_policy",
        "nucleus_detection_segmentation_classification"
      ],
      "title": "Workstream",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline": {
      "$ref": "#/$defs/RunSummary"
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "clinical_validity": {
      "const": false,
      "title": "Clinical Validity",
      "type": "boolean"
    },
    "data_source_kind": {
      "enum": [
        "synthetic_fixture",
        "pathologize_registry"
      ],
      "title": "Data Source Kind",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "recommendation": {
      "enum": [
        "baseline_only",
        "promote_candidate",
        "reject_candidate"
      ],
      "title": "Recommendation",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scorecard_id": {
      "pattern": "^scorecard:sha256:[a-f0-9]{64}$",
      "title": "Scorecard Id",
      "type": "string"
    },
    "synthetic_evidence_only": {
      "title": "Synthetic Evidence Only",
      "type": "boolean"
    },
    "workstream": {
      "$ref": "#/$defs/Workstream"
    }
  },
  "required": [
    "schema_version",
    "scorecard_id",
    "experiment_id",
    "workstream",
    "data_source_kind",
    "synthetic_evidence_only",
    "baseline",
    "candidate",
    "gates",
    "recommendation",
    "clinical_validity"
  ],
  "title": "Scorecard",
  "type": "object"
}

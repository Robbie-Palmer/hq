{
  "$defs": {
    "AdapterSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "title": "Adapter Id",
          "type": "string"
        },
        "artifact_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Path"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "entrypoint": {
          "minLength": 1,
          "title": "Entrypoint",
          "type": "string"
        },
        "kind": {
          "enum": [
            "builtin",
            "python_entrypoint"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "adapter_id",
        "kind",
        "entrypoint",
        "version"
      ],
      "title": "AdapterSpec",
      "type": "object"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "$ref": "#/$defs/AdapterSpec"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "failure_report": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "predictions": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "resources": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "run_id": {
      "pattern": "^run:sha256:[a-f0-9]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "adapter",
    "predictions",
    "resources",
    "failure_report"
  ],
  "title": "RunRecord",
  "type": "object"
}

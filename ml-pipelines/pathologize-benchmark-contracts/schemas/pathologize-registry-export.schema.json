{
  "$defs": {
    "CroissantDatasetReference": {
      "additionalProperties": false,
      "properties": {
        "conforms_to": {
          "const": "http://mlcommons.org/croissant/1.1",
          "title": "Conforms To",
          "type": "string"
        },
        "metadata_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Metadata Sha256",
          "type": "string"
        },
        "metadata_uri": {
          "minLength": 1,
          "title": "Metadata Uri",
          "type": "string"
        }
      },
      "required": [
        "conforms_to",
        "metadata_uri",
        "metadata_sha256"
      ],
      "title": "CroissantDatasetReference",
      "type": "object"
    },
    "DicomWsiInterchangeRepresentation": {
      "additionalProperties": false,
      "properties": {
        "conforms_to": {
          "const": "https://dicom.nema.org/medical/dicom/2026c/output/chtml/part03/sect_A.32.8.html",
          "title": "Conforms To",
          "type": "string"
        },
        "croissant_distribution_id": {
          "minLength": 1,
          "title": "Croissant Distribution Id",
          "type": "string"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Derived From",
          "type": "array"
        },
        "dicom_sop_class_uid": {
          "const": "1.2.840.10008.5.1.4.1.1.77.1.6",
          "title": "Dicom Sop Class Uid",
          "type": "string"
        },
        "format": {
          "const": "dicom_wsi",
          "title": "Format",
          "type": "string"
        },
        "representation_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "title": "Representation Id",
          "type": "string"
        },
        "role": {
          "const": "interchange",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "representation_id",
        "croissant_distribution_id",
        "derived_from",
        "format",
        "conforms_to",
        "dicom_sop_class_uid",
        "role"
      ],
      "title": "DicomWsiInterchangeRepresentation",
      "type": "object"
    },
    "DicomWsiSourceRepresentation": {
      "additionalProperties": false,
      "properties": {
        "conforms_to": {
          "const": "https://dicom.nema.org/medical/dicom/2026c/output/chtml/part03/sect_A.32.8.html",
          "title": "Conforms To",
          "type": "string"
        },
        "croissant_distribution_id": {
          "minLength": 1,
          "title": "Croissant Distribution Id",
          "type": "string"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Derived From",
          "type": "array"
        },
        "dicom_sop_class_uid": {
          "const": "1.2.840.10008.5.1.4.1.1.77.1.6",
          "title": "Dicom Sop Class Uid",
          "type": "string"
        },
        "format": {
          "const": "dicom_wsi",
          "title": "Format",
          "type": "string"
        },
        "representation_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "title": "Representation Id",
          "type": "string"
        },
        "role": {
          "const": "source",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "representation_id",
        "croissant_distribution_id",
        "format",
        "conforms_to",
        "dicom_sop_class_uid",
        "role"
      ],
      "title": "DicomWsiSourceRepresentation",
      "type": "object"
    },
    "LeakageKeys": {
      "additionalProperties": false,
      "properties": {
        "acquisition_id": {
          "minLength": 1,
          "title": "Acquisition Id",
          "type": "string"
        },
        "block_id": {
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "site_id": {
          "minLength": 1,
          "title": "Site Id",
          "type": "string"
        },
        "slide_id": {
          "minLength": 1,
          "title": "Slide Id",
          "type": "string"
        },
        "specimen_id": {
          "minLength": 1,
          "title": "Specimen Id",
          "type": "string"
        },
        "subject_id": {
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "specimen_id",
        "block_id",
        "slide_id",
        "acquisition_id",
        "site_id"
      ],
      "title": "LeakageKeys",
      "type": "object"
    },
    "OmeZarrRepresentation": {
      "additionalProperties": false,
      "properties": {
        "conforms_to": {
          "const": "https://ngff.openmicroscopy.org/specifications/0.6/",
          "title": "Conforms To",
          "type": "string"
        },
        "croissant_distribution_id": {
          "minLength": 1,
          "title": "Croissant Distribution Id",
          "type": "string"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Derived From",
          "type": "array"
        },
        "dicom_sop_class_uid": {
          "const": null,
          "default": null,
          "title": "Dicom Sop Class Uid",
          "type": "null"
        },
        "format": {
          "const": "ome_zarr",
          "title": "Format",
          "type": "string"
        },
        "representation_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "title": "Representation Id",
          "type": "string"
        },
        "role": {
          "const": "compute_derivative",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "representation_id",
        "croissant_distribution_id",
        "derived_from",
        "role",
        "format",
        "conforms_to"
      ],
      "title": "OmeZarrRepresentation",
      "type": "object"
    },
    "RegistryAnnotation": {
      "additionalProperties": false,
      "properties": {
        "croissant_record_id": {
          "minLength": 1,
          "title": "Croissant Record Id",
          "type": "string"
        },
        "croissant_record_set_id": {
          "minLength": 1,
          "title": "Croissant Record Set Id",
          "type": "string"
        },
        "derived_from_representation": {
          "minLength": 1,
          "title": "Derived From Representation",
          "type": "string"
        },
        "kind": {
          "enum": [
            "tissue_mask",
            "artifact_mask",
            "nucleus_instances",
            "nucleus_classes"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "croissant_record_set_id",
        "croissant_record_id",
        "derived_from_representation"
      ],
      "title": "RegistryAnnotation",
      "type": "object"
    },
    "RegistryItem": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "items": {
            "$ref": "#/$defs/RegistryAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "croissant_record_id": {
          "minLength": 1,
          "title": "Croissant Record Id",
          "type": "string"
        },
        "croissant_record_set_id": {
          "minLength": 1,
          "title": "Croissant Record Set Id",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "leakage": {
          "$ref": "#/$defs/LeakageKeys"
        },
        "microns_per_pixel_x": {
          "exclusiveMinimum": 0,
          "title": "Microns Per Pixel X",
          "type": "number"
        },
        "microns_per_pixel_y": {
          "exclusiveMinimum": 0,
          "title": "Microns Per Pixel Y",
          "type": "number"
        },
        "representations": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/VendorNativeWsiRepresentation"
              },
              {
                "$ref": "#/$defs/DicomWsiSourceRepresentation"
              },
              {
                "$ref": "#/$defs/DicomWsiInterchangeRepresentation"
              },
              {
                "$ref": "#/$defs/OmeZarrRepresentation"
              }
            ]
          },
          "minItems": 1,
          "title": "Representations",
          "type": "array"
        },
        "split": {
          "$ref": "#/$defs/Split"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "split",
        "croissant_record_set_id",
        "croissant_record_id",
        "width",
        "height",
        "microns_per_pixel_x",
        "microns_per_pixel_y",
        "leakage",
        "representations",
        "annotations"
      ],
      "title": "RegistryItem",
      "type": "object"
    },
    "RegistryProvenance": {
      "additionalProperties": false,
      "properties": {
        "prov_o_conforms_to": {
          "const": "https://www.w3.org/TR/prov-o/",
          "title": "Prov O Conforms To",
          "type": "string"
        },
        "prov_o_graph_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prov O Graph Sha256",
          "type": "string"
        },
        "prov_o_graph_uri": {
          "minLength": 1,
          "title": "Prov O Graph Uri",
          "type": "string"
        },
        "ro_crate_conforms_to": {
          "const": "https://w3id.org/ro/crate/1.3",
          "title": "Ro Crate Conforms To",
          "type": "string"
        },
        "ro_crate_metadata_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Ro Crate Metadata Sha256",
          "type": "string"
        },
        "ro_crate_metadata_uri": {
          "minLength": 1,
          "title": "Ro Crate Metadata Uri",
          "type": "string"
        }
      },
      "required": [
        "ro_crate_conforms_to",
        "ro_crate_metadata_uri",
        "ro_crate_metadata_sha256",
        "prov_o_conforms_to",
        "prov_o_graph_uri",
        "prov_o_graph_sha256"
      ],
      "title": "RegistryProvenance",
      "type": "object"
    },
    "Split": {
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "VendorNativeWsiRepresentation": {
      "additionalProperties": false,
      "properties": {
        "conforms_to": {
          "const": null,
          "title": "Conforms To",
          "type": "null"
        },
        "croissant_distribution_id": {
          "minLength": 1,
          "title": "Croissant Distribution Id",
          "type": "string"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Derived From",
          "type": "array"
        },
        "dicom_sop_class_uid": {
          "const": null,
          "default": null,
          "title": "Dicom Sop Class Uid",
          "type": "null"
        },
        "format": {
          "const": "vendor_native_wsi",
          "title": "Format",
          "type": "string"
        },
        "representation_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "title": "Representation Id",
          "type": "string"
        },
        "role": {
          "const": "source",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "representation_id",
        "croissant_distribution_id",
        "role",
        "format",
        "conforms_to"
      ],
      "title": "VendorNativeWsiRepresentation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "pathologize.data-registry-export/v1",
      "title": "Contract",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/CroissantDatasetReference"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/RegistryItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/RegistryProvenance"
    },
    "registry_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Registry Revision",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "registry_revision",
    "dataset",
    "provenance",
    "items"
  ],
  "title": "RegistryExport",
  "type": "object"
}

{
  "$defs": {
    "LeakageKeys": {
      "additionalProperties": false,
      "properties": {
        "acquisition_id": {
          "minLength": 1,
          "title": "Acquisition Id",
          "type": "string"
        },
        "block_id": {
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "site_id": {
          "minLength": 1,
          "title": "Site Id",
          "type": "string"
        },
        "slide_id": {
          "minLength": 1,
          "title": "Slide Id",
          "type": "string"
        },
        "specimen_id": {
          "minLength": 1,
          "title": "Specimen Id",
          "type": "string"
        },
        "subject_id": {
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "specimen_id",
        "block_id",
        "slide_id",
        "acquisition_id",
        "site_id"
      ],
      "title": "LeakageKeys",
      "type": "object"
    },
    "RegistryAnnotation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "tissue_mask",
            "artifact_mask",
            "nucleus_instances",
            "nucleus_classes"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri",
        "sha256"
      ],
      "title": "RegistryAnnotation",
      "type": "object"
    },
    "RegistryItem": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "items": {
            "$ref": "#/$defs/RegistryAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "image_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "image_uri": {
          "minLength": 1,
          "title": "Image Uri",
          "type": "string"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "leakage": {
          "$ref": "#/$defs/LeakageKeys"
        },
        "microns_per_pixel_x": {
          "exclusiveMinimum": 0,
          "title": "Microns Per Pixel X",
          "type": "number"
        },
        "microns_per_pixel_y": {
          "exclusiveMinimum": 0,
          "title": "Microns Per Pixel Y",
          "type": "number"
        },
        "split": {
          "$ref": "#/$defs/Split"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "split",
        "image_uri",
        "image_sha256",
        "width",
        "height",
        "microns_per_pixel_x",
        "microns_per_pixel_y",
        "leakage",
        "annotations"
      ],
      "title": "RegistryItem",
      "type": "object"
    },
    "Split": {
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "title": "Split",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "pathologize.data-registry-export/v1",
      "title": "Contract",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/RegistryItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "registry_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Registry Revision",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "registry_revision",
    "items"
  ],
  "title": "RegistryExport",
  "type": "object"
}

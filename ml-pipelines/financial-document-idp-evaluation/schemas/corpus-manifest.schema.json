{
  "$defs": {
    "CorpusManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "adversarial_tags": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "type": "string"
          },
          "title": "Adversarial Tags",
          "type": "array"
        },
        "byte_size": {
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "consent_or_generation_method": {
          "minLength": 1,
          "title": "Consent Or Generation Method",
          "type": "string"
        },
        "document_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Document Id",
          "type": "string"
        },
        "expected_abstention": {
          "title": "Expected Abstention",
          "type": "boolean"
        },
        "expected_abstention_reason": {
          "anyOf": [
            {
              "enum": [
                "prompt_injection",
                "low_confidence"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Abstention Reason"
        },
        "family": {
          "$ref": "#/$defs/DocumentFamily"
        },
        "ground_truth_path": {
          "pattern": "^ground-truth/[a-z0-9._-]+\\.json$",
          "title": "Ground Truth Path",
          "type": "string"
        },
        "mime_type": {
          "enum": [
            "application/pdf",
            "text/html",
            "image/x-portable-graymap"
          ],
          "title": "Mime Type",
          "type": "string"
        },
        "redaction_status": {
          "enum": [
            "not_applicable_synthetic",
            "strongly_redacted"
          ],
          "title": "Redaction Status",
          "type": "string"
        },
        "relative_path": {
          "pattern": "^documents/[a-z0-9._-]+$",
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_rights": {
          "minLength": 1,
          "title": "Source Rights",
          "type": "string"
        },
        "strata": {
          "$ref": "#/$defs/CorpusStrata"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "document_id",
        "family",
        "relative_path",
        "mime_type",
        "sha256",
        "byte_size",
        "source_rights",
        "consent_or_generation_method",
        "redaction_status",
        "synthetic",
        "strata",
        "ground_truth_path",
        "expected_abstention",
        "expected_abstention_reason",
        "adversarial_tags"
      ],
      "title": "CorpusManifestEntry",
      "type": "object"
    },
    "CorpusStrata": {
      "additionalProperties": false,
      "properties": {
        "document_format": {
          "$ref": "#/$defs/DocumentFormat"
        },
        "language": {
          "pattern": "^[a-z]{2}$",
          "title": "Language",
          "type": "string"
        },
        "scan_quality": {
          "$ref": "#/$defs/ScanQuality"
        }
      },
      "required": [
        "document_format",
        "scan_quality",
        "language"
      ],
      "title": "CorpusStrata",
      "type": "object"
    },
    "DocumentFamily": {
      "enum": [
        "bank_statement",
        "credit_card_statement",
        "payslip"
      ],
      "title": "DocumentFamily",
      "type": "string"
    },
    "DocumentFormat": {
      "enum": [
        "pdf_text",
        "html",
        "pgm_scan"
      ],
      "title": "DocumentFormat",
      "type": "string"
    },
    "ScanQuality": {
      "enum": [
        "native",
        "clean_scan",
        "degraded_scan"
      ],
      "title": "ScanQuality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "corpus_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Corpus Version",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/CorpusManifestEntry"
      },
      "minItems": 1,
      "title": "Documents",
      "type": "array"
    },
    "generated_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:00:00Z$",
      "title": "Generated At",
      "type": "string"
    },
    "privacy_policy": {
      "const": "synthetic_or_strongly_redacted_only",
      "title": "Privacy Policy",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "corpus_version",
    "generated_at",
    "privacy_policy",
    "documents"
  ],
  "title": "CorpusManifest",
  "type": "object"
}

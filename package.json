{
  "name": "hq",
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "private": true,
  "type": "module",
  "description": "Root package for projects, writing, infrastructure, and homelab",
  "dependencies": {
    "observability": "workspace:*",
    "recipe-domain": "workspace:*",
    "ts-base": "workspace:*"
  },
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24",
    "husky": "^9.1.7",
    "knip": "6.36.0",
    "lint-staged": "^17.0.0",
    "markdownlint-cli": "^0.49.0",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint": "^10.0.0",
    "remark-lint-list-item-indent": "^4.0.1",
    "remark-mdx": "^3.1.0",
    "remark-preset-lint-recommended": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "yaml": "2.9.1",
    "yaml-lint": "^1.7.0"
  },
  "lint-staged": {
    "ui/**/*.{ts,tsx,js,jsx,json}": [
      "mise run //ui:format"
    ],
    "infra/public-platform/**/*.tf": [
      "mise run //infra/public-platform:format",
      "mise run //infra/public-platform:precommit-lint",
      "mise run //infra/public-platform:lint:tflint"
    ],
    "infra/bootstrap/**/*.tf": [
      "mise run //infra/bootstrap:format",
      "mise run //infra/bootstrap:precommit-lint",
      "mise run //infra/bootstrap:lint:tflint"
    ],
    "infra/remote-development/**/*.tf": [
      "mise run //infra/remote-development:format",
      "mise run //infra/remote-development:precommit-lint",
      "mise run //infra/remote-development:lint:tflint"
    ],
    "infra/work-graph/**/*.tf": [
      "mise run //infra/work-graph:format",
      "mise run //infra/work-graph:precommit-lint",
      "bash -c 'mise run //infra/work-graph:lint:tflint' --"
    ],
    "**/*.md": [
      "mise run //:lint:markdown",
      "mise run //:lint:prose:staged"
    ],
    "**/*.mdx": [
      "mise run //:lint:mdx",
      "mise run //:lint:prose:staged"
    ],
    "*.{yml,yaml}": [
      "mise run //:lint:yaml"
    ],
    "homelab/**/*.{yml,yaml}": [
      "mise run //:lint:yaml"
    ]
  }
}

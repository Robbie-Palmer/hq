{
  "$defs": {
    "AccessTier": {
      "enum": [
        "public",
        "registration_required",
        "restricted"
      ],
      "title": "AccessTier",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "access_tier": {
          "$ref": "#/$defs/AccessTier"
        },
        "checksum": {
          "$ref": "#/$defs/Checksum"
        },
        "coordinate_frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoordinateFrame"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "media_type": {
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "physical_scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicalScale"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "product": {
          "$ref": "#/$defs/ProductVersion"
        },
        "rights": {
          "$ref": "#/$defs/Rights"
        },
        "role": {
          "$ref": "#/$defs/ArtifactRole"
        },
        "source_record": {
          "minLength": 1,
          "title": "Source Record",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "product",
        "source_record",
        "role",
        "checksum",
        "media_type",
        "rights",
        "access_tier"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ArtifactRole": {
      "enum": [
        "source_archive",
        "source_image",
        "source_annotation",
        "source_mask",
        "source_manifest",
        "source_records",
        "table",
        "manifest",
        "adapter",
        "partition",
        "report",
        "annotation",
        "mask",
        "tile",
        "embedding",
        "registration",
        "transformed_image",
        "measurement",
        "bag",
        "instance",
        "label_evidence",
        "feature",
        "model_input"
      ],
      "title": "ArtifactRole",
      "type": "string"
    },
    "Checksum": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Checksum",
      "type": "object"
    },
    "ComposedRecord": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "minLength": 1,
          "title": "Adapter",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Attributes",
          "type": "object"
        },
        "derived_artifact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Derived Artifact Ids",
          "type": "array"
        },
        "partition": {
          "minLength": 1,
          "title": "Partition",
          "type": "string"
        },
        "product": {
          "$ref": "#/$defs/ProductVersion"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "upstream_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "minItems": 1,
          "title": "Upstream Artifacts",
          "type": "array"
        }
      },
      "required": [
        "product",
        "record_id",
        "upstream_artifacts",
        "adapter",
        "partition"
      ],
      "title": "ComposedRecord",
      "type": "object"
    },
    "CoordinateFrame": {
      "additionalProperties": false,
      "properties": {
        "axes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Axes",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "name",
        "axes",
        "origin"
      ],
      "title": "CoordinateFrame",
      "type": "object"
    },
    "DerivedArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DerivedArtifactKind"
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "parents": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "minItems": 1,
          "title": "Parents",
          "type": "array"
        },
        "reference": {
          "$ref": "#/$defs/ArtifactReference"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "reference",
        "operation",
        "parents"
      ],
      "title": "DerivedArtifact",
      "type": "object"
    },
    "DerivedArtifactKind": {
      "enum": [
        "annotation",
        "mask",
        "tile",
        "embedding",
        "registration",
        "transformed_image",
        "measurement",
        "bag",
        "instance",
        "label_evidence",
        "feature",
        "model_input"
      ],
      "title": "DerivedArtifactKind",
      "type": "string"
    },
    "JsonValue": {},
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "code_revision": {
          "minLength": 1,
          "title": "Code Revision",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "name",
        "parameters",
        "code_revision"
      ],
      "title": "Operation",
      "type": "object"
    },
    "PhysicalScale": {
      "additionalProperties": false,
      "properties": {
        "micrometres_per_pixel_x": {
          "exclusiveMinimum": 0,
          "title": "Micrometres Per Pixel X",
          "type": "number"
        },
        "micrometres_per_pixel_y": {
          "exclusiveMinimum": 0,
          "title": "Micrometres Per Pixel Y",
          "type": "number"
        }
      },
      "required": [
        "micrometres_per_pixel_x",
        "micrometres_per_pixel_y"
      ],
      "title": "PhysicalScale",
      "type": "object"
    },
    "ProductVersion": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "pattern": "^[a-z0-9][a-z0-9._/-]*$",
          "title": "Product",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "product",
        "version"
      ],
      "title": "ProductVersion",
      "type": "object"
    },
    "PublishedArtifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/PublishedArtifactKind"
        },
        "reference": {
          "$ref": "#/$defs/ArtifactReference"
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "title": "PublishedArtifact",
      "type": "object"
    },
    "PublishedArtifactKind": {
      "enum": [
        "table",
        "manifest",
        "adapter",
        "partition",
        "report"
      ],
      "title": "PublishedArtifactKind",
      "type": "string"
    },
    "Rights": {
      "additionalProperties": false,
      "properties": {
        "evidence_uri": {
          "format": "uri",
          "minLength": 1,
          "title": "Evidence Uri",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "redistribution": {
          "minLength": 1,
          "title": "Redistribution",
          "type": "string"
        }
      },
      "required": [
        "license",
        "redistribution",
        "evidence_uri"
      ],
      "title": "Rights",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "identity": {
      "$ref": "#/$defs/ProductVersion"
    },
    "kind": {
      "const": "derived",
      "default": "derived",
      "title": "Kind",
      "type": "string"
    },
    "new_artifacts": {
      "items": {
        "$ref": "#/$defs/DerivedArtifact"
      },
      "title": "New Artifacts",
      "type": "array"
    },
    "published_artifacts": {
      "items": {
        "$ref": "#/$defs/PublishedArtifact"
      },
      "title": "Published Artifacts",
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ComposedRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "upstream_products": {
      "items": {
        "$ref": "#/$defs/ProductVersion"
      },
      "minItems": 1,
      "title": "Upstream Products",
      "type": "array"
    }
  },
  "required": [
    "identity",
    "upstream_products",
    "records",
    "published_artifacts",
    "new_artifacts"
  ],
  "title": "DerivedProduct",
  "type": "object"
}

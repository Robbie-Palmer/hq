    "test:mutation:full": "stryker run stryker-full.config.mjs"
  },
  "dependencies": {
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }

{
  "name": "project-economics-domain",
  "version": "0.1.0",
  "private": true,
  "description": "Domain contracts for project costs and operational evidence",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./costs": "./src/costs.ts",
    "./model": "./src/model.ts",
    "./repositories": "./src/repositories.ts",
    "./shared-cost-attribution": "./src/shared-cost-attribution.ts",
    "./telemetry": "./src/telemetry.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",

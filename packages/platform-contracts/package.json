{
  "name": "platform-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned source contracts for the personal engineering platform",
  "type": "module",
  "exports": {
    "./deployment-maturity": "./src/deployment-maturity.ts",
    "./feature-flags": "./src/feature-flags.ts",
    "./nix-flake": "./src/nix-flake.ts",
    "./opentelemetry": "./src/opentelemetry.ts",
    "./platform-manifest": "./src/platform-manifest.ts",
    "./repository-layout": "./src/repository-layout.ts",
    "./workload": "./src/workload.ts"
  },
  "scripts": {
    "docs:check": "tsx scripts/generate-deployment-maturity-docs.ts --check && tsx scripts/generate-workload-docs.ts --check",
    "docs:generate": "tsx scripts/generate-deployment-maturity-docs.ts && tsx scripts/generate-workload-docs.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ts-base": "workspace:*",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@openfeature/server-sdk": "1.23.0",
    "@openfeature/web-sdk": "1.10.0",
    "@posthog/openfeature-node-provider": "0.1.3",
    "@posthog/openfeature-web-provider": "0.1.1",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.0",
    "posthog-js": "1.442.1",
    "posthog-node": "5.60.1",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "wrangler": "^4",
    "yaml": "2.9.1"
  }
}

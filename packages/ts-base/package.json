{
  "name": "ts-base",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-free TypeScript extensions to JavaScript and web-standard APIs",
  "type": "module",
  "exports": {
    "./crypto": "./src/crypto.ts",
    "./errors": "./src/errors.ts",
    "./layered-graph": "./src/layered-graph.ts",

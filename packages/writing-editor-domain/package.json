{
  "name": "writing-editor-domain",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned records for writing suggestions, proposals, and edit decisions",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./canonical-json": "./src/canonical-json.ts",
    "./decisions": "./src/decisions.ts",
    "./findings": "./src/findings.ts",
    "./proposals": "./src/proposals.ts",
    "./suggestions": "./src/suggestions.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
}

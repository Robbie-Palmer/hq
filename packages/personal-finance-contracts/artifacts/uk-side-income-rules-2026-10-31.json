        ]
      },
      "test": {
        "kind": "threshold",
        "measure": "prior-return-qualifying-income",
        "comparison": "more-than",
        "amount": {
          "minorUnits": 3000000,
          "currency": "GBP",
          "jurisdiction": "GB"
        },
        "referenceTaxYear": "2025-26"
      },
      "outcome": "Use Making Tax Digital for Income Tax from 2027-04-06.",

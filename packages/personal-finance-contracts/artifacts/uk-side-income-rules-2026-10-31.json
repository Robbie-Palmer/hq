  "rules": [
    {
      "id": "uk.sole-trader.self-assessment-registration",
      "version": "2026-10-31",
      "topic": "sole-trader-registration",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": "2017-04-06",
        "effectiveTo": null,
        "structures": [
          "sole-trader"
        ],
        "activityKinds": [
          "product-sales",
          "subscription-sales",
          "freelance-services",
          "contracting-services"
        ],
        "notes": [
          "The threshold uses aggregate gross trading income for a tax year, before costs.",
          "Other registration reasons can apply below the threshold."
        ]
      },
      "test": {
        "kind": "threshold",
        "measure": "annual-gross-trading-income",
        "comparison": "more-than",
        "amount": {
          "minorUnits": 100000,
          "currency": "GBP",
          "jurisdiction": "GB"
        },
        "referenceTaxYear": null
      },
      "outcome": "Register for Self Assessment as a sole trader.",
      "sourceId": "register-sole-trader"
    },
    {
      "id": "uk.sole-trader.trading-allowance",
      "version": "2026-10-31",
      "topic": "trading-allowance",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": "2017-04-06",
        "effectiveTo": null,
        "structures": [
          "sole-trader"
        ],
        "activityKinds": [
          "product-sales",
          "subscription-sales",
          "freelance-services",
          "contracting-services"
        ],
        "notes": [
          "The allowance is shared across an individual's trades.",
          "Partnership income and specified connected-party or employer-related income are excluded.",
          "Claiming partial relief replaces deductions for actual expenses and other allowances."
        ]
      },
      "test": {
        "kind": "threshold",
        "measure": "annual-gross-trading-income",
        "comparison": "more-than",
        "amount": {
          "minorUnits": 100000,
          "currency": "GBP",
          "jurisdiction": "GB"
        },
        "referenceTaxYear": null
      },
      "outcome": "Check full or partial trading-allowance relief against actual costs.",
      "sourceId": "tax-free-allowances-on-property-and-trading-income"
    },
    {
      "id": "uk.company.formation",
      "version": "2026-10-31",
      "topic": "company-formation",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": null,
        "effectiveTo": null,
        "structures": [
          "uk-limited-company"
        ],
        "activityKinds": [
          "product-sales",
          "subscription-sales",
          "freelance-services",
          "contracting-services"
        ],
        "notes": [
          "Register the company with Companies House and identify people with significant control.",
          "Company registration usually sets up Corporation Tax unless the company is dormant."
        ]
      },
      "test": {
        "kind": "duty",
        "trigger": "company-exists"
      },
      "outcome": "Maintain the registered company and its Corporation Tax account.",
      "sourceId": "register-your-company"
    },
    {
      "id": "uk.company.director-reporting",
      "version": "2026-10-31",
      "topic": "company-reporting",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": null,
        "effectiveTo": null,
        "structures": [
          "uk-limited-company"
        ],
        "activityKinds": [
          "product-sales",
          "subscription-sales",
          "freelance-services",
          "contracting-services"
        ],
        "notes": [
          "Directors remain responsible for company records, annual accounts, Company Tax Returns, filing, and Corporation Tax."
        ]
      },
      "test": {
        "kind": "duty",
        "trigger": "company-exists"
      },
      "outcome": "Keep company records and meet Companies House and HMRC filing duties.",
      "sourceId": "directors-responsibilities"
    },
    {
      "id": "uk.company.paye-registration",
      "version": "2026-10-31",
      "topic": "payroll",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": null,
        "effectiveTo": null,
        "structures": [
          "uk-limited-company"
        ],
        "activityKinds": [
          "product-sales",
          "subscription-sales",
          "freelance-services",
          "contracting-services"
        ],
        "notes": [
          "A company normally registers before its first payday, including when it employs only its director."
        ]
      },
      "test": {
        "kind": "duty",
        "trigger": "company-pays-salary-benefits-or-expenses"
      },
      "outcome": "Register as an employer and operate PAYE.",
      "sourceId": "register-employer"
    },
    {
      "id": "uk.company.withdrawals",
      "version": "2026-10-31",
      "topic": "company-withdrawals",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": null,
        "effectiveTo": null,
        "structures": [
          "uk-limited-company"
        ],
        "activityKinds": [
          "product-sales",
          "subscription-sales",
          "freelance-services",
          "contracting-services"
        ],
        "notes": [
          "Salary uses payroll; dividends require available profit and company records.",
          "Company revenue, company profit, and company cash are not personal salary or household cash."
        ]
      },
      "test": {
        "kind": "duty",
        "trigger": "company-pays-dividend"
      },
      "outcome": "Document dividends and keep them separate from salary and company costs.",
      "sourceId": "taking-money-out-of-a-limited-company"
    },
    {
      "id": "uk.vat.registration",
      "version": "2026-10-31",
      "topic": "vat",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": "2024-04-01",
        "effectiveTo": null,
        "structures": [
          "sole-trader",
          "uk-limited-company"
        ],
        "activityKinds": [
          "product-sales",
          "subscription-sales",
          "freelance-services",
          "contracting-services"
        ],
        "notes": [
          "Test both rolling 12-month taxable turnover and expected taxable turnover in the next 30 days.",
          "Voluntary registration and special rules can apply below or outside this threshold."
        ]
      },
      "test": {
        "kind": "threshold",
        "measure": "trailing-twelve-month-taxable-turnover",
        "comparison": "more-than",
        "amount": {
          "minorUnits": 9000000,
          "currency": "GBP",
          "jurisdiction": "GB"
        },
        "referenceTaxYear": null
      },
      "outcome": "Register for VAT unless an exemption or exception applies.",
      "sourceId": "register-for-vat"
    },
    {
      "id": "uk.mtd-income-tax.2024-25",
      "version": "2026-10-31",
      "topic": "making-tax-digital",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": "2026-04-06",
        "effectiveTo": null,
        "structures": [
          "sole-trader"
        ],
        "activityKinds": [
          "product-sales",
          "subscription-sales",
          "freelance-services",
          "contracting-services"
        ],
        "notes": [
          "Qualifying income is gross self-employment and property income from the specified prior tax return.",
          "The person must already be registered for Self Assessment and have submitted a return."
        ]
      },
      "test": {
        "kind": "threshold",
        "measure": "prior-return-qualifying-income",
        "comparison": "more-than",
        "amount": {
          "minorUnits": 5000000,
          "currency": "GBP",
          "jurisdiction": "GB"
        },
        "referenceTaxYear": "2024-25"
      },
      "outcome": "Use Making Tax Digital for Income Tax from 2026-04-06.",
      "sourceId": "using-making-tax-digital-for-income-tax-for-the-first-time"
    },
    {
      "id": "uk.mtd-income-tax.2025-26",
      "version": "2026-10-31",
      "topic": "making-tax-digital",
      "applicability": {

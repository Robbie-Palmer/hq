    {
      "id": "uk.mtd-income-tax.2026-27",
      "version": "2026-10-31",
      "topic": "making-tax-digital",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": "2028-04-06",
        "effectiveTo": null,
        "structures": [
          "sole-trader"
        ],
        "activityKinds": [
          "product-sales",

    },
    {
      "id": "uk.off-payroll.contract-assessment",
      "version": "2026-10-31",
      "topic": "off-payroll-working",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": "2021-04-06",
        "effectiveTo": null,
        "structures": [
          "uk-limited-company"
        ],
        "activityKinds": [
          "freelance-services",
          "contracting-services"
        ],
        "notes": [
          "Apply the status test contract by contract when services pass through an intermediary.",
          "The responsible party depends on the client sector and size."
        ]
      },
      "test": {
        "kind": "contract-assessment",
        "trigger": "services-through-intermediary",
        "assessmentScope": "each-contract"
      },
      "outcome": "Record an employment-status determination for each relevant service contract.",
      "sourceId": "understanding-off-payroll-working-ir35"
    },
    {
      "id": "uk.umbrella.employment-arrangement",
      "version": "2026-10-31",
      "topic": "umbrella-employment",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": null,
        "effectiveTo": null,
        "structures": [
          "umbrella-employment"
        ],
        "activityKinds": [
          "freelance-services",
          "contracting-services"
        ],
        "notes": [
          "An umbrella company employs the worker; it is not a business entity for the worker to establish.",
          "The arrangement needs a provider and a contract of employment."
        ]
      },
      "test": {
        "kind": "duty",
        "trigger": "umbrella-arrangement-used"
      },
      "outcome": "Confirm a suitable umbrella provider and employment arrangement.",
      "sourceId": "working-through-an-umbrella-company"
    },
    {
      "id": "uk.umbrella.paye-chain-2026",
      "version": "2026-10-31",
      "topic": "payroll",
      "applicability": {
        "jurisdiction": "GB",
        "effectiveFrom": "2026-04-06",
        "effectiveTo": null,
        "structures": [
          "umbrella-employment"
        ],
        "activityKinds": [
          "freelance-services",
          "contracting-services"
        ],
        "notes": [
          "The agency nearest the end client, or the end client without an agency, must ensure PAYE is operated correctly.",
          "Non-UK labour-supply chains need a separate review."
        ]
      },
      "test": {
        "kind": "duty",
        "trigger": "umbrella-payment-on-or-after-date"
      },
      "outcome": "Confirm PAYE responsibility across the labour-supply chain.",
      "sourceId": "paye-rules-for-labour-supply-chains-that-include-umbrella-companies-from-6-april-2026"
    }
  ]

{% set cloudflare_pages = blueprint.selections | selectattr("slot", "equalto", "web-app.host") | selectattr("value", "equalto", "cloudflare-pages") | list | length > 0 -%}
{% set cloudflare_worker = blueprint.selections | selectattr("slot", "equalto", "backend-api.runtime") | selectattr("value", "equalto", "cloudflare-workers") | list | length > 0 -%}
{% set cloudflare_access = blueprint.selections | selectattr("slot", "equalto", "security.preview-access") | selectattr("value", "equalto", "cloudflare-access") | list | length > 0 -%}
{% set cloudflare_r2 = blueprint.selections | selectattr("slot", "equalto", "storage.object-store") | selectattr("value", "equalto", "cloudflare-r2") | list | length > 0 -%}
{% set public_ingress = blueprint.selections | selectattr("slot", "equalto", "network.public-ingress") | list | length > 0 -%}
{% set cloudflare_dns = false -%}
{% set neon = blueprint.selections | selectattr("slot", "equalto", "database.relational-host") | selectattr("value", "equalto", "neon") | list | length > 0 -%}
{% set neon_preview = neon and blueprint.selections | selectattr("slot", "equalto", "database.preview-isolation") | list | length > 0 -%}
{% set telemetry = blueprint.selections | selectattr("slot", "equalto", "observability.application-telemetry") | selectattr("value", "equalto", "posthog") | list | length > 0 -%}
{% set cloudflare = cloudflare_pages or cloudflare_worker or cloudflare_access or cloudflare_r2 or cloudflare_dns -%}
# Generated by Copier from the resolved project blueprint. Do not edit.

terraform {
  required_version = ">= 1.14, < 2.0"

  required_providers {
{% if cloudflare %}
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 4.52"
    }
{% endif %}
{% if neon %}
    neon = {
      source  = "kislerdm/neon"
      version = "~> 0.18"
    }
{% endif %}
{% if telemetry %}
    posthog = {
      source  = "PostHog/posthog"
      version = "~> 1.0"
    }
{% endif %}
  }
}

{% if cloudflare %}
provider "cloudflare" {}

{% endif %}
{% if neon %}
provider "neon" {}

{% endif %}
{% if telemetry %}
provider "posthog" {}

{% endif %}
{% if cloudflare_pages %}
variable "cloudflare_pages" {
  description = "Cloudflare Pages project selected by the resolved blueprint."
  type = object({
    account_id           = string
    name                 = string
    production_branch    = string
    build_command        = string
    destination_dir      = string
    root_dir             = optional(string, "")
    production_variables = optional(map(string), {})
    preview_variables    = optional(map(string), {})
    compatibility_date   = string
    compatibility_flags  = optional(set(string), [])
    custom_domain = optional(object({
      hostname = string
      zone_id  = string
    }))
  })
}

module "cloudflare_pages" {
  source    = "../project-modules/v1/modules/cloudflare-pages"
  providers = { cloudflare = cloudflare }

  account_id           = var.cloudflare_pages.account_id
  name                 = var.cloudflare_pages.name
  production_branch    = var.cloudflare_pages.production_branch
  build_command        = var.cloudflare_pages.build_command
  destination_dir      = var.cloudflare_pages.destination_dir
  root_dir             = var.cloudflare_pages.root_dir
  production_variables = var.cloudflare_pages.production_variables
  preview_variables    = var.cloudflare_pages.preview_variables
  compatibility_date   = var.cloudflare_pages.compatibility_date
  compatibility_flags  = var.cloudflare_pages.compatibility_flags
  custom_domain        = var.cloudflare_pages.custom_domain
  access               = {% if cloudflare_access %}var.cloudflare_access{% else %}null{% endif %}
}

{% endif %}
{% if cloudflare_worker %}
variable "cloudflare_worker" {
  description = "Cloudflare Worker selected by the resolved blueprint."
  type = object({
    account_id         = string
    name               = string
    content            = string
    compatibility_date = string
    zone_id            = optional(string)
    hostname           = optional(string)
  })

  validation {
    condition     = (var.cloudflare_worker.zone_id == null) == (var.cloudflare_worker.hostname == null)
    error_message = "cloudflare_worker zone_id and hostname must be supplied together."
  }
}

module "cloudflare_worker" {
  source    = "../project-modules/v1/modules/cloudflare-worker"
  providers = { cloudflare = cloudflare }

  account_id         = var.cloudflare_worker.account_id
  name               = var.cloudflare_worker.name
  content            = var.cloudflare_worker.content
  compatibility_date = var.cloudflare_worker.compatibility_date
  zone_id            = var.cloudflare_worker.zone_id
  hostname           = var.cloudflare_worker.hostname
}

{% endif %}
{% if cloudflare_access %}
variable "cloudflare_access" {
  description = "Cloudflare Access policy selected by the resolved blueprint."
  type = object({
    account_id       = string
    name             = string
    domain           = string
    allowed_emails   = set(string)
    session_duration = optional(string, "24h")
  })
}

module "cloudflare_access" {
  source    = "../project-modules/v1/modules/cloudflare-access"
  providers = { cloudflare = cloudflare }
{% if cloudflare_pages %}
  depends_on = [module.cloudflare_pages]
{% endif %}

  account_id       = var.cloudflare_access.account_id
  name             = var.cloudflare_access.name
  domain           = var.cloudflare_access.domain
  allowed_emails   = var.cloudflare_access.allowed_emails
  session_duration = var.cloudflare_access.session_duration
}

{% endif %}
{% if cloudflare_r2 %}
variable "cloudflare_r2" {
  description = "Cloudflare R2 buckets selected by the resolved blueprint."
  type = object({
    account_id = string
    buckets = map(object({
      name     = string
      location = optional(string, "ENAM")
    }))
  })
}

module "cloudflare_r2" {
  source    = "../project-modules/v1/modules/cloudflare-r2"
  providers = { cloudflare = cloudflare }

  account_id = var.cloudflare_r2.account_id
  buckets    = var.cloudflare_r2.buckets
}

{% endif %}
{% if cloudflare_dns %}
variable "cloudflare_dns" {
  description = "Cloudflare DNS records selected by the resolved blueprint."
  type = object({
    zone_id = string
    records = map(object({
      name    = string
      content = string
      type    = string
      proxied = optional(bool, true)
      ttl     = optional(number, 1)
    }))
  })
}

module "cloudflare_dns" {
  source    = "../project-modules/v1/modules/cloudflare-dns"
  providers = { cloudflare = cloudflare }

  zone_id = var.cloudflare_dns.zone_id
  records = var.cloudflare_dns.records
}

{% endif %}
{% if neon %}
variable "neon" {
  description = "Neon project selected by the resolved blueprint."
  type = object({
    org_id                    = string
    project_name              = string
    database_name             = string
    role_name                 = string
    region_id                 = string
    pg_version                = number
    history_retention_seconds = optional(number, 21600)
    preview_project_name      = optional(string)
  })
}

module "neon" {
  source    = "../project-modules/v1/modules/neon"
  providers = { neon = neon }

  org_id                    = var.neon.org_id
  project_name              = var.neon.project_name
  database_name             = var.neon.database_name
  role_name                 = var.neon.role_name
  region_id                 = var.neon.region_id
  pg_version                = var.neon.pg_version
  history_retention_seconds = var.neon.history_retention_seconds
  preview_enabled           = {{ "true" if neon_preview else "false" }}
  preview_project_name      = var.neon.preview_project_name
}

{% endif %}
{% if telemetry %}
variable "telemetry" {
  description = "PostHog operations dashboard selected by the resolved blueprint."
  type = object({
    dashboard_name        = string
    dashboard_description = string
    tags                  = set(string)
  })
}

module "telemetry" {
  source    = "../project-modules/v1/modules/telemetry"
  providers = { posthog = posthog }

  project_id            = "{{ blueprint.project.id }}"
  dashboard_name        = var.telemetry.dashboard_name
  dashboard_description = var.telemetry.dashboard_description
  tags                  = var.telemetry.tags
}

{% endif %}
output "selected_capabilities" {
  description = "Capabilities compiled into this Terraform root by Copier."
  value = toset([
{% if cloudflare_pages %}    "web-app.host",
{% endif %}{% if cloudflare_worker %}    "backend-api.runtime",
{% endif %}{% if cloudflare_access %}    "security.preview-access",
{% endif %}{% if cloudflare_r2 %}    "storage.object-store",
{% endif %}{% if public_ingress %}    "network.public-ingress",
{% endif %}{% if neon %}    "database.relational-host",
{% endif %}{% if neon_preview %}    "database.preview-isolation",
{% endif %}{% if telemetry %}    "observability.application-telemetry",
{% endif %}  ])
}

output "resource_ownership" {
  description = "Provider resource IDs grouped under the compiled project identity."
  value = merge(
    { project_id = "{{ blueprint.project.id }}" },
{% if cloudflare_pages %}    { pages_project = module.cloudflare_pages.project_id },
    { pages_domain = module.cloudflare_pages.domain_id },
    { pages_access_applications = module.cloudflare_pages.access_application_ids },
{% endif %}{% if cloudflare_worker %}    { worker = module.cloudflare_worker.worker_id },
{% endif %}{% if cloudflare_access %}    { access_application = module.cloudflare_access.application_id },
{% endif %}{% if cloudflare_r2 %}    { r2_buckets = module.cloudflare_r2.bucket_ids },
{% endif %}{% if cloudflare_dns %}    { dns_records = module.cloudflare_dns.record_ids },
{% endif %}{% if neon %}    { neon = module.neon.resource_ids },
{% endif %}{% if telemetry %}    { telemetry_dashboard = module.telemetry.dashboard_id },
{% endif %}  )
}

{% if neon_preview %}
output "preview_database_connection_uri" {
  description = "Sensitive connection URI for the isolated preview database."
  value       = module.neon.preview_connection_uri
  sensitive   = true
}
{%- endif -%}

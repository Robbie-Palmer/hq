{% set rollout = blueprint.rollout | default({"operational_checks": [], "migration_checkpoints": []}, true) -%}
# Managed by Copier; record evidence in the project profile, not in this file.
schema_version: 1
project: "{{ blueprint.project.stable_id }}"
{% if rollout.stateful_operations | default(none, true) %}stateful_operations: "operations/generated-operations.yaml"
{% endif %}
{% if rollout.operational_checks %}operational_checks:
{% for check in rollout.operational_checks %}  - id: "{{ check.id }}"
    command: "{{ check.command }}"
{% endfor %}{% else %}operational_checks: []
{% endif %}{% if rollout.migration_checkpoints %}migration_checkpoints:
{% for checkpoint in rollout.migration_checkpoints %}  - id: "{{ checkpoint.id }}"
    action: "{{ checkpoint.action }}"
    verification: "{{ checkpoint.verification }}"
    status: "{{ checkpoint.status }}"
{% if checkpoint.evidence %}    evidence:
{% for item in checkpoint.evidence %}      - "{{ item }}"
{% endfor %}{% else %}    evidence: []
{% endif %}{% endfor %}{% else %}migration_checkpoints: []
{% endif -%}

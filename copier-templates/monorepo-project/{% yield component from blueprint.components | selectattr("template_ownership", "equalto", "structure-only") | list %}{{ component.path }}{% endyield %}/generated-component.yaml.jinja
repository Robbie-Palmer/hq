{% set rollout = blueprint.rollout | default({"operational_checks": [], "migration_checkpoints": []}, true) -%}
# Managed by Copier; product logic and secret values do not belong in this file.
schema_version: 1
component:
  id: "{{ component.id }}"
  stable_id: "{{ component.stable_id }}"
  name: "{{ component.name }}"
  kind: "{{ component.kind }}"
  path: "{{ component.path }}"
  project: "{{ blueprint.project.stable_id }}"
ownership:
  template_files:
    - "generated-component.yaml"
    - "mise.toml"
{% if component.runtime_role | default("") == "authenticated-worker" %}    - "package.json"
    - "src/auth.ts"
    - "src/authorization.ts"
    - "src/index.ts"
    - "src/runtime.ts"
    - "wrangler.toml"
{% elif component.runtime_role | default("") == "relational-data" %}    - "drizzle.config.ts"
    - "package.json"
    - "src/connection.ts"
    - "src/index.ts"
    - "src/runtime-schema.ts"
    - "src/schema.ts"
{% endif %}{% if component.runtime_role | default("") == "authenticated-worker" %}  project_extensions:
    - "src/project-authorization.ts"
    - "src/project-routes.ts"
{% elif component.runtime_role | default("") == "relational-data" %}  project_extensions:
    - "src/project-schema.ts"
{% else %}  project_extensions: []
{% endif %}{% if component.runtime_role | default("") != "" %}  runtime_role: "{{ component.runtime_role }}"
{% endif %}
  product_logic: "project"
  secrets: "external"
rollout:
{% if rollout.operational_checks %}  operational_checks:
{% for check in rollout.operational_checks %}    - id: "{{ check.id }}"
      command: "{{ check.command }}"
{% endfor %}{% else %}  operational_checks: []
{% endif %}{% if rollout.migration_checkpoints %}  migration_checkpoints:
{% for checkpoint in rollout.migration_checkpoints %}    - id: "{{ checkpoint.id }}"
      status: "{{ checkpoint.status }}"
      verification: "{{ checkpoint.verification }}"
{% endfor %}{% else %}  migration_checkpoints: []
{% endif -%}

stages:
  build_fixture:
    cmd: uv run --locked {{ component.id }} build-fixture
    deps:
      - fixtures/synthetic.json
      - ${fixture.rights}
      - pyproject.toml
      - registries/datasets.json
      - src/{{ component.id | replace('-', '_') }}
      - uv.lock
    params:
      - fixture
    outs:
      - data/synthetic

  train:
    cmd: uv run --locked {{ component.id }} train
    deps:
      - data/synthetic
      - pyproject.toml
      - src/{{ component.id | replace('-', '_') }}
      - uv.lock
    params:
      - training
    outs:
      - artifacts/model.json

  evaluate:
    cmd: uv run --locked {{ component.id }} evaluate
    deps:
      - artifacts/model.json
      - data/synthetic
      - manifests/decision-provenance.json
      - ${fixture.rights}
      - params.yaml
      - pyproject.toml
      - registries/downstream-evaluations.json
      - src/{{ component.id | replace('-', '_') }}
      - uv.lock
    params:
      - evaluation
    outs:
      - outputs/evaluation.json
      - outputs/provenance.json
    metrics:
      - metrics/metrics.json

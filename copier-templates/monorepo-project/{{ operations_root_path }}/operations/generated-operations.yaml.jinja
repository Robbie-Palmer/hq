{% set operations = blueprint.rollout.stateful_operations -%}
# Generated by Copier from the resolved project blueprint. Do not edit.
schema_version: 1
project: {{ blueprint.project.stable_id | tojson }}
data_classification: "synthetic-only"
evidence:
  schema: "operations/rollout-evidence.schema.json"
  directory: "operations/evidence"
capabilities:
{% for selection in blueprint.selections | selectattr("slot", "in", ["delivery.preview-environment", "security.preview-access", "database.preview-isolation", "database.backup-restore", "storage.object-store", "observability.telemetry-protocol", "observability.application-telemetry", "observability.alert-evaluation", "observability.alert-delivery"]) | sort(attribute="slot") %}  - slot: {{ selection.slot | tojson }}
    value: {{ selection.value | tojson }}
{% endfor %}preview:
  github_environment: {{ operations.preview.github_environment | tojson }}
  secret_config_ref: {{ operations.preview.secret_config_ref | tojson }}
  isolation:
    database: "fresh Neon branch from empty preview base"
    credentials: "preview-scoped"
    data: "synthetic-only"
  hooks:
    provision: {{ operations.preview.provision | tojson }}
    migrate: {{ operations.preview.migrate | tojson }}
    seed_synthetic: {{ operations.preview.seed_synthetic | tojson }}
    deploy: {{ operations.preview.deploy | tojson }}
    smoke_authenticated: {{ operations.preview.smoke_authenticated | tojson }}
    smoke_telemetry: {{ operations.preview.smoke_telemetry | tojson }}
    cleanup: {{ operations.preview.cleanup | tojson }}
production:
  github_environment: {{ operations.production.github_environment | tojson }}
  plan_secret_config_ref: {{ operations.production.plan_secret_config_ref | tojson }}
  apply_secret_config_ref: {{ operations.production.apply_secret_config_ref | tojson }}
  terraform:
    plan_artifact: "operations/evidence/production.tfplan.age"
    reviewed_plan_digest: "operations/evidence/production.tfplan.sha256"
    encryption: "age"
  hooks:
    migrate: {{ operations.production.migrate | tojson }}
    deploy: {{ operations.production.deploy | tojson }}
    smoke: {{ operations.production.smoke | tojson }}
    rollback: {{ operations.production.rollback | tojson }}
{% if operations.backup %}backup:
  github_environment: {{ operations.backup.github_environment | tojson }}
  secret_config_ref: {{ operations.backup.secret_config_ref | tojson }}
  schedule: {{ operations.backup.schedule | tojson }}
  storage: "R2 age-encrypted PostgreSQL custom archives"
  hooks:
    create: {{ operations.backup.create | tojson }}
    restore: {{ operations.backup.restore | tojson }}
{% endif %}{% if operations.alerting %}alerting:
  github_environment: {{ operations.alerting.github_environment | tojson }}
  secret_config_ref: {{ operations.alerting.secret_config_ref | tojson }}
  responder: {{ operations.alerting.responder | tojson }}
  hooks:
    smoke: {{ operations.alerting.smoke | tojson }}
{% endif %}secret_handoff_checkpoints:
  - id: "preview-read-write-scope"
    reference: {{ operations.preview.secret_config_ref | tojson }}
    status: "pending"
    proof: []
  - id: "production-plan-read-only-scope"
    reference: {{ operations.production.plan_secret_config_ref | tojson }}
    status: "pending"
    proof: []
  - id: "production-apply-protected-scope"
    reference: {{ operations.production.apply_secret_config_ref | tojson }}
    status: "pending"
    proof: []
  - id: "terraform-plan-age-key-custody"
    reference: {{ operations.production.apply_secret_config_ref | tojson }}
    status: "pending"
    proof: []
{% if operations.backup %}  - id: "backup-r2-and-age-custody"
    reference: {{ operations.backup.secret_config_ref | tojson }}
    status: "pending"
    proof: []
{% endif %}{% if operations.alerting %}  - id: "alert-destination-routing"
    reference: {{ operations.alerting.secret_config_ref | tojson }}
    status: "pending"
    proof: []
{% endif -%}

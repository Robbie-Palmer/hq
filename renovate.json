{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "7 days",
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track annotated versions in homelab shell scripts",
      "managerFilePatterns": [
        "/^homelab/.+\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+[A-Z][A-Z0-9_]*=\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Track pip packages pinned in workflow run steps (e.g. dvc[s3]==x.y.z)",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "pip install[^']*'(?<depName>[a-zA-Z0-9._-]+)(?:\\[[a-zA-Z0-9,_-]+\\])?==(?<currentValue>[0-9][^']+)'"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Track homelab container image pins expressed as compose variable defaults (${SVC_VERSION:-tag})",
      "managerFilePatterns": [
        "/homelab/hosts/mac-mini/.+/docker-compose\\.yml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>[a-z0-9./-]+):\\$\\{(?:PROWLARR|SONARR|RADARR|QBITTORRENT|JELLYFIN|RECYCLARR)_VERSION:-(?<currentValue>[^}]+)\\}"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track exact Debian packages in the t3-code bindep manifest",
      "managerFilePatterns": [
        "/^homelab/images/t3-code/bindep\\.txt$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9+.-]*) ==(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Keep the workerd test runner on the Vitest version supported by Cloudflare's pool",
      "matchFileNames": [
        "ai-review/package.json"
      ],
      "matchPackageNames": [
        "vitest",
        "@vitest/coverage-v8"
      ],
      "allowedVersions": "<5"
    },
    {
      "description": "Keep Vitest and its coverage provider aligned across workspace packages",
      "matchPackageNames": [
        "vitest",
        "@vitest/coverage-v8"
      ],
      "groupName": "vitest"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Auto-merge devDependencies (non-major)",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Auto-merge production patches",
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Auto-merge Mermaid minor updates covered by browser rendering tests",
      "matchPackageNames": [
        "mermaid"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Auto-merge GitHub Actions (all updates)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "major"
      ],
      "automerge": true
    },
    {
      "description": "Auto-merge mise-managed dev tooling - linters, scanners and toolchains that CI exercises on every PR",
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Resolve the t3-code runtime packages from Debian Bookworm repositories",
      "matchFileNames": [
        "homelab/images/t3-code/bindep.txt"
      ],
      "matchDatasources": [
        "deb"
      ],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=bookworm&components=main&binaryArch=amd64",
        "https://deb.debian.org/debian?suite=bookworm-updates&components=main&binaryArch=amd64",
        "https://security.debian.org/debian-security?suite=bookworm-security&components=main&binaryArch=amd64"
      ],
      "groupName": "t3-code Debian packages"
    },
    {
      "description": "Review age and jq by hand - the backup job runs against real data and no CI job proves these beforehand",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "age",
        "jq"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "Auto-merge pip tooling pinned in workflow run steps (e.g. dvc)",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Let pydantic manage its exact pydantic-core pin in compiled requirements",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "pydantic-core"
      ],
      "enabled": false
    },
    {
      "description": "ml-pipelines is offline tooling with no deploy of its own, so treat its runtime dependencies like devDependencies",
      "matchFileNames": [
        "ml-pipelines/**"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Keep python on the 3.12 minor line - ml-pipelines is locked to 3.12 and bumping to 3.13/3.14 is a deliberate decision, but 3.12.x patch releases are still welcome",
      "matchManagers": [
        "mise",
        "pyenv"
      ],
      "matchDepNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "description": "packageManager tracks the pnpm 12 line via the latest-12 dist-tag - npm latest still points at 11.x, and once on 12.x respectLatest would hide every later 12.x release",
      "matchManagers": [
        "npm"
      ],
      "matchDepNames": [
        "pnpm"
      ],
      "matchDepTypes": [
        "packageManager"
      ],
      "followTag": "latest-12"
    },
    {
      "description": "Keep pnpm aligned across packageManager, mise, and the t3-code runtime image",
      "matchPackageNames": [
        "pnpm",
        "pnpm/pnpm"
      ],
      "groupName": "pnpm"
    },
    {
      "description": "Keep the Vale binary and writing evaluation version contract in one PR",
      "matchPackageNames": [
        "vale-cli/vale"
      ],
      "groupName": "vale",
      "minimumReleaseAge": "3 days",
      "dependencyDashboardApproval": false,
      "automerge": true
    },
    {
      "description": "Keep the uv toolchain aligned across C++ and ML tooling",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "uv"
      ],
      "groupName": "uv"
    },
    {
      "description": "Keep the Docker CLI image and remote-development DinD daemon in one PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker"
      ],
      "groupName": "docker engine and cli",
      "minimumReleaseAge": "3 days",
      "dependencyDashboardApproval": false,
      "automerge": true
    },
    {
      "description": "Auto-merge pnpm updates after the pinned binary passes the workspace compatibility check",
      "matchPackageNames": [
        "pnpm",
        "pnpm/pnpm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "major"
      ],
      "minimumReleaseAge": "3 days",
      "dependencyDashboardApproval": false,
      "automerge": true
    },
    {
      "description": "Auto-merge coding-agent and t3 orchestrator updates after the runtime image checks pass",
      "matchFileNames": [
        "homelab/images/t3-code/package.json"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchPackageNames": [
        "!pnpm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "major"
      ],
      "minimumReleaseAge": "3 days",
      "dependencyDashboardApproval": false,
      "automerge": true
    },
    {
      "description": "Keep the bundled Claude Code, Codex, Grok, and OpenCode CLIs in one update",
      "matchFileNames": [
        "homelab/images/t3-code/package.json"
      ],
      "matchPackageNames": [
        "@anthropic-ai/claude-code",
        "@openai/codex",
        "@xai-official/grok",
        "opencode-ai"
      ],
      "groupName": "coding agent CLIs"
    },
    {
      "description": "drizzle-orm (dependencies) and drizzle-kit (devDependencies) generate and apply the same migrations, so land them together and review by hand",
      "matchPackageNames": [
        "drizzle-orm",
        "drizzle-kit"
      ],
      "groupName": "drizzle",
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "Group the Cloudflare Workers toolchain so wrangler and its types/test-pool packages stay aligned",
      "matchPackageNames": [
        "wrangler",
        "@cloudflare/**"
      ],
      "groupName": "cloudflare workers toolchain"
    },
    {
      "description": "Disable release age for lockfile maintenance",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Review Nix flake updates by hand after CI evaluates the NixOS definitions",
      "matchManagers": [
        "nix"
      ],
      "groupName": "nix flake inputs",
      "automerge": false
    },
    {
      "description": "Review homelab script dependency updates by hand",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "homelab/**/*.sh"
      ],
      "automerge": false
    },
    {
      "description": "Media stack images run unattended against real data - group and review bumps by hand instead of automerging",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/sonarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/qbittorrent",
        "jellyfin/jellyfin",
        "ghcr.io/recyclarr/recyclarr"
      ],
      "groupName": "media stack images",
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "Auto-merge every t3-code development image dependency after its image checks pass",
      "matchFileNames": [
        "homelab/images/t3-code/**"
      ],
      "minimumReleaseAge": "3 days",
      "dependencyDashboardApproval": false,
      "automerge": true
    }
  ]
}

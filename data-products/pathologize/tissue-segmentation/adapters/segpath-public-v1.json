{
  "schema_version": "1.0.0",
  "adapter_id": "segpath-2022-registered-if-masks-to-tissue-compartment-v1",
  "source_kind": "segpath",
  "source_dataset_id": "segpath-2022-registered-if-masks",
  "source_interface_version": "1.0.0",
  "target_ontology_id": "pathologize.tissue-compartment/v1",
  "coverage_semantics": "positive_binary_only",
  "expected_image_techniques": ["H&E"],
  "expected_annotation_techniques": ["IF"],
  "mappings": [
    {"source_label": "epithelium", "source_values": ["1"], "target_labels": ["epithelium"], "status": "partial", "rationale": "The source target does not separate neoplastic from non-neoplastic epithelium."},
    {"source_label": "smooth muscle/myofibroblast", "source_values": ["1"], "target_labels": ["smooth_muscle_or_myofibroblast"], "status": "source_merged", "rationale": "The source antibody target does not separate smooth muscle from myofibroblasts."},
    {"source_label": "red blood cell", "source_values": ["1"], "target_labels": ["erythrocyte"], "status": "exact", "rationale": "Same cell-type meaning."},
    {"source_label": "leukocyte", "source_values": ["1"], "target_labels": ["leukocyte"], "status": "exact", "rationale": "Same broad cell-type meaning."},
    {"source_label": "lymphocyte", "source_values": ["1"], "target_labels": ["lymphocyte"], "status": "exact", "rationale": "Same cell-type meaning."},
    {"source_label": "blood vessel, lymphatic vessel", "source_values": ["1"], "target_labels": ["blood_vessel", "lymphatic_vessel"], "status": "source_merged", "rationale": "The source target does not separate blood from lymphatic vessels."},
    {"source_label": "plasma cell", "source_values": ["1"], "target_labels": ["plasma_cell"], "status": "exact", "rationale": "Same cell-type meaning."},
    {"source_label": "myeloid cell", "source_values": ["1"], "target_labels": ["myeloid_cell"], "status": "exact", "rationale": "Same cell-type meaning."}
  ],
  "limitations": [
    "Each SegPath mask marks one IF-defined positive cell type; zero pixels are not a general background or exhaustive negative class.",
    "The H&E image and IF-derived mask are related by source registration, so annotation assay and registration provenance must remain attached.",
    "SegPath semantic masks do not introduce nucleus or cell instances into this product."
  ]
}

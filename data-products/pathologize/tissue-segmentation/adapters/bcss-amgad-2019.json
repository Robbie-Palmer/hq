{
  "schema_version": "1.0.0",
  "adapter_id": "bcss-amgad-2019-to-tissue-compartment-v1",
  "source_kind": "bcss",
  "source_dataset_id": "bcss-amgad-2019",
  "source_interface_version": "1.0.0",
  "target_ontology_id": "pathologize.tissue-compartment/v1",
  "coverage_semantics": "exhaustive_multiclass_with_ignore",
  "expected_image_techniques": ["H&E"],
  "expected_annotation_techniques": [],
  "mappings": [
    {"source_label": "outside_roi", "source_values": ["0"], "target_labels": ["ignore"], "status": "exact", "rationale": "Publisher-defined don't-care pixels remain ignored."},
    {"source_label": "tumor", "source_values": ["1"], "target_labels": ["neoplastic_epithelium"], "status": "partial", "rationale": "BCSS tumor does not encode invasive status."},
    {"source_label": "stroma", "source_values": ["2"], "target_labels": ["stroma"], "status": "exact", "rationale": "Same compartment meaning."},
    {"source_label": "lymphocytic_infiltrate", "source_values": ["3"], "target_labels": ["lymphocyte"], "status": "partial", "rationale": "BCSS labels an infiltrate region rather than individual lymphocytes."},
    {"source_label": "necrosis_or_debris", "source_values": ["4"], "target_labels": ["necrosis_or_debris"], "status": "source_merged", "rationale": "The source does not separate necrosis from debris."},
    {"source_label": "glandular_secretions", "source_values": ["5"], "target_labels": ["secretion_or_mucin"], "status": "partial", "rationale": "The target union is broader than glandular secretions."},
    {"source_label": "blood", "source_values": ["6"], "target_labels": ["blood"], "status": "exact", "rationale": "Same compartment meaning."},
    {"source_label": "exclude", "source_values": ["7"], "target_labels": ["ignore"], "status": "dropped", "rationale": "Publisher-excluded pixels cannot become a tissue target."},
    {"source_label": "metaplasia_NOS", "source_values": ["8"], "target_labels": ["epithelium"], "status": "partial", "rationale": "The target does not claim a metaplasia subtype."},
    {"source_label": "fat", "source_values": ["9"], "target_labels": ["adipose"], "status": "exact", "rationale": "Same compartment meaning."},
    {"source_label": "plasma_cells", "source_values": ["10"], "target_labels": ["plasma_cell"], "status": "exact", "rationale": "Plural source region maps to the same cell compartment."},
    {"source_label": "other_immune_infiltrate", "source_values": ["11"], "target_labels": ["leukocyte"], "status": "partial", "rationale": "The source category excludes lymphocytes but lacks a finer type."},
    {"source_label": "mucoid_material", "source_values": ["12"], "target_labels": ["secretion_or_mucin"], "status": "partial", "rationale": "The target union is broader than mucoid material."},
    {"source_label": "normal_acinus_or_duct", "source_values": ["13"], "target_labels": ["non_neoplastic_epithelium"], "status": "source_merged", "rationale": "Acinus and duct remain inseparable."},
    {"source_label": "lymphatics", "source_values": ["14"], "target_labels": ["lymphatic_vessel"], "status": "exact", "rationale": "Same compartment meaning."},
    {"source_label": "undetermined", "source_values": ["15"], "target_labels": ["unknown"], "status": "unmapped", "rationale": "No tissue meaning can be inferred."},
    {"source_label": "nerve", "source_values": ["16"], "target_labels": ["nerve"], "status": "exact", "rationale": "Same compartment meaning."},
    {"source_label": "skin_adnexa", "source_values": ["17"], "target_labels": ["skin_adnexa"], "status": "exact", "rationale": "Same compartment meaning."},
    {"source_label": "blood_vessel", "source_values": ["18"], "target_labels": ["blood_vessel"], "status": "exact", "rationale": "Same compartment meaning."},
    {"source_label": "angioinvasion", "source_values": ["19"], "target_labels": ["angioinvasion"], "status": "exact", "rationale": "The target retains the spatial relation."},
    {"source_label": "dcis", "source_values": ["20"], "target_labels": ["non_invasive_neoplastic_epithelium"], "status": "exact", "rationale": "DCIS is retained as non-invasive neoplastic epithelium."},
    {"source_label": "other", "source_values": ["21"], "target_labels": ["other_tissue"], "status": "unmapped", "rationale": "The source gives no narrower meaning."}
  ],
  "limitations": [
    "BCSS covers breast H&E ROIs only.",
    "Zero-valued outside-ROI pixels are ignore pixels, not background or other tissue.",
    "The source's merged and indeterminate labels remain visible in mapping status."
  ]
}

{
  "$defs": {
    "NativeArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "bytes": {
          "exclusiveMinimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "md5": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Md5",
          "type": "string"
        },
        "retrieval_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Retrieval Url",
          "type": "string"
        },
        "role": {
          "enum": [
            "mrxs_named_slide_file",
            "scanner_metadata_xml",
            "annotation_xml"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "artifact_ref",
        "filename",
        "role",
        "bytes",
        "md5",
        "retrieval_url"
      ],
      "title": "NativeArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotation_status": {
      "const": "empty annotations element",
      "title": "Annotation Status",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/NativeArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "availability": {
      "const": "metadata_only",
      "title": "Availability",
      "type": "string"
    },
    "case_id": {
      "pattern": "^YW_DP[1-5]_[0-9]{3}$",
      "title": "Case Id",
      "type": "string"
    },
    "dataset_id": {
      "const": "skin-frozen-ffpe-preview-zenodo-18780726-v1",
      "title": "Dataset Id",
      "type": "string"
    },
    "identical_cutting_plane": {
      "const": false,
      "title": "Identical Cutting Plane",
      "type": "boolean"
    },
    "paired_case_ref": {
      "minLength": 1,
      "title": "Paired Case Ref",
      "type": "string"
    },
    "pairing_basis": {
      "const": "publisher-declared same case",
      "title": "Pairing Basis",
      "type": "string"
    },
    "pixel_payload_status": {
      "const": "missing companion MRXS pixel directory",
      "title": "Pixel Payload Status",
      "type": "string"
    },
    "preparation": {
      "enum": [
        "frozen",
        "ffpe"
      ],
      "title": "Preparation",
      "type": "string"
    },
    "publisher_folder": {
      "minLength": 1,
      "title": "Publisher Folder",
      "type": "string"
    },
    "publisher_partition": {
      "title": "Publisher Partition",
      "type": "null"
    },
    "record_ref": {
      "minLength": 1,
      "title": "Record Ref",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_role": {
      "const": "qualitative reference and reproducibility checks",
      "title": "Source Role",
      "type": "string"
    },
    "spatial_registration": {
      "const": false,
      "title": "Spatial Registration",
      "type": "boolean"
    },
    "specimen_context": {
      "const": "skin cancer resection margins",
      "title": "Specimen Context",
      "type": "string"
    },
    "subtype": {
      "minLength": 1,
      "title": "Subtype",
      "type": "string"
    },
    "usable_wsi": {
      "const": false,
      "title": "Usable Wsi",
      "type": "boolean"
    }
  },
  "required": [
    "dataset_id",
    "record_ref",
    "case_id",
    "publisher_folder",
    "subtype",
    "specimen_context",
    "preparation",
    "source_role",
    "publisher_partition",
    "paired_case_ref",
    "pairing_basis",
    "spatial_registration",
    "identical_cutting_plane",
    "availability",
    "usable_wsi",
    "pixel_payload_status",
    "annotation_status",
    "artifacts"
  ],
  "title": "NativeRecord",
  "type": "object"
}

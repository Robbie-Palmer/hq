{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robbiepalmer.me/contracts/project-rollout-evidence-v1.schema.json",
  "title": "Project rollout evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "action",
    "outcome",
    "subject",
    "revision",
    "recorded_at",
    "plan_digest",
    "steps"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "pattern": "^project:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "action": {
      "enum": [
        "preview-up",
        "preview-cleanup",
        "production-plan",
        "production-apply",
        "production-rollback",
        "backup",
        "restore",
        "alert-smoke"
      ]
    },
    "outcome": { "enum": ["passed", "failed"] },
    "subject": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "plan_digest": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "started_at", "finished_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "outcome": { "enum": ["passed", "failed"] },
          "started_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}

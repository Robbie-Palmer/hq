{
  "schemaVersion": 1,
  "cluster": "remote-development-candidate",
  "workspaces": [
    {
      "id": "operator",
      "owner": "operator",
      "namespace": "t3-operator",
      "nodePool": "workspace-elastic",
      "nodeSelector": {
        "remote-development.robbiepalmer.dev/role": "workspace"
      },
      "location": "nbg1",
      "volumeClaim": "workspace-data",
      "storageClass": "hcloud-volumes-retain",
      "volumeSizeGiB": 90,
      "backupSet": "remote-development-candidate/operator",
      "endpoint": {
        "kind": "kubectl-port-forward",
        "localPort": 3773,
        "targetPort": 3773
      }
    },
    {
      "id": "pilot",
      "owner": "pilot-user",
      "namespace": "t3-pilot",
      "nodePool": "workspace-elastic",
      "nodeSelector": {
        "remote-development.robbiepalmer.dev/role": "workspace"
      },
      "location": "nbg1",
      "volumeClaim": "workspace-data",
      "storageClass": "hcloud-volumes-retain",
      "volumeSizeGiB": 90,
      "backupSet": "remote-development-candidate/pilot",
      "endpoint": {
        "kind": "kubectl-port-forward",
        "localPort": 3774,
        "targetPort": 3773
      }
    }
  ],
  "cachePolicy": {
    "kind": "ephemeral",
    "sizeLimitGiB": 20,
    "retainedAfterPodReplacement": false,
    "protectedPaths": [
      "/data/home/.t3",
      "/data/home/.codex",
      "/data/home/.codex-personal",
      "/data/workspaces"
    ]
  }
}

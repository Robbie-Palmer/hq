#!/bin/bash

set -euo pipefail

mode="dry-run"
database="${HOME}/.t3/userdata/state.sqlite"
worktree_root="${HOME}/.t3/worktrees"
state_dir="${HOME}/Library/Application Support/homelab/t3-worktree-cleanup"
deleted_days=2
archived_days=7
settled_days=7

usage() {
  cat <<'EOF'
Usage: t3-worktree-cleanup [options]

Safely remove old T3 worktrees while preserving dirty changes in durable Git refs.

Options:
  --apply                  Perform cleanup. The default is a read-only dry run.
  --dry-run                Report eligible worktrees without changing them.
  --database PATH          T3 state database.
  --worktree-root PATH     Allowed parent directory for removable worktrees.
  --state-dir PATH         Directory used for the single-instance lock.
  --deleted-days DAYS      Retention after explicit deletion. Default: 2.
  --archived-days DAYS     Retention after archival. Default: 7.
  --settled-days DAYS      Retention after settlement. Default: 7.
  -h, --help               Show this help.
EOF
}

log() {
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"
}

die() {
  log "ERROR $*" >&2
  exit 1
}

require_non_negative_integer() {
  value=$1
  name=$2
  case "$value" in
    ''|*[!0-9]*) die "$name must be a non-negative integer" ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --apply)
      mode="apply"
      shift
      ;;
    --dry-run)
      mode="dry-run"
      shift
      ;;
    --database|--worktree-root|--state-dir|--deleted-days|--archived-days|--settled-days)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      option=$1
      value=$2
      shift 2
      case "$option" in
        --database) database=$value ;;
        --worktree-root) worktree_root=$value ;;
        --state-dir) state_dir=$value ;;
        --deleted-days) deleted_days=$value ;;
        --archived-days) archived_days=$value ;;
        --settled-days) settled_days=$value ;;
      esac
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

require_non_negative_integer "$deleted_days" "--deleted-days"
require_non_negative_integer "$archived_days" "--archived-days"
require_non_negative_integer "$settled_days" "--settled-days"

git_binary=/usr/bin/git
sqlite_binary=/usr/bin/sqlite3
ps_binary=/bin/ps

[ -x "$git_binary" ] || die "Git is unavailable at $git_binary"
[ -x "$sqlite_binary" ] || die "SQLite is unavailable at $sqlite_binary"
[ -x "$ps_binary" ] || die "ps is unavailable at $ps_binary"
[ -f "$database" ] || die "T3 state database does not exist: $database"
[ -d "$worktree_root" ] || die "T3 worktree root does not exist: $worktree_root"

umask 077
mkdir -p "$state_dir"
lock_dir="${state_dir}/lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  lock_pid=$(cat "${lock_dir}/pid" 2>/dev/null || true)
  if [ -n "$lock_pid" ] \
    && kill -0 "$lock_pid" 2>/dev/null \
    && "$ps_binary" -p "$lock_pid" -o command= | grep -q 't3-worktree-cleanup'; then
    log "SKIP cleanup process ${lock_pid} already holds $lock_dir"
    exit 0
  fi
  rm -f "${lock_dir}/pid"
  rmdir "$lock_dir" 2>/dev/null || die "cannot recover stale lock at $lock_dir"
  mkdir "$lock_dir" || die "cannot acquire cleanup lock at $lock_dir"
fi
printf '%s\n' "$$" >"${lock_dir}/pid"

temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/t3-worktree-cleanup.XXXXXX")
candidate_file="${temporary_dir}/candidates.tsv"

cleanup() {
  rm -f "$candidate_file"
  rmdir "$temporary_dir" 2>/dev/null || true
  rm -f "${lock_dir}/pid"
  rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

worktree_root_physical=$(cd "$worktree_root" && pwd -P)

required_columns='projection_threads:thread_id
projection_threads:worktree_path
projection_threads:deleted_at
projection_threads:archived_at
projection_threads:settled_at
projection_threads:updated_at
projection_threads:pinned_at
projection_threads:pending_approval_count
projection_threads:pending_user_input_count
projection_thread_sessions:thread_id
projection_thread_sessions:status
projection_thread_sessions:active_turn_id
provider_session_runtime:thread_id
provider_session_runtime:status'

while IFS=: read -r table_name column_name; do
  present=$(
    "$sqlite_binary" -readonly "$database" \
      "SELECT COUNT(*) FROM pragma_table_info('${table_name}') WHERE name = '${column_name}';"
  )
  [ "$present" = "1" ] || die "unsupported T3 database schema: missing ${table_name}.${column_name}"
done <<EOF
$required_columns
EOF

"$sqlite_binary" -readonly -separator $'\t' "$database" >"$candidate_file" <<SQL
SELECT
  t.thread_id,
  t.worktree_path,
  CASE
    WHEN t.deleted_at IS NOT NULL THEN 'deleted'
    WHEN t.archived_at IS NOT NULL THEN 'archived'
    ELSE 'settled'
  END,
  COALESCE(t.deleted_at, t.archived_at, t.settled_at)
FROM projection_threads AS t
LEFT JOIN projection_thread_sessions AS s ON s.thread_id = t.thread_id
LEFT JOIN provider_session_runtime AS r ON r.thread_id = t.thread_id
WHERE t.worktree_path IS NOT NULL
  AND t.pinned_at IS NULL
  AND t.pending_approval_count = 0
  AND t.pending_user_input_count = 0
  AND COALESCE(s.status, 'stopped') NOT IN ('running', 'starting')
  AND s.active_turn_id IS NULL
  AND COALESCE(r.status, 'stopped') NOT IN ('running', 'starting')
  AND (
    (t.deleted_at IS NOT NULL AND julianday('now') - julianday(t.deleted_at) >= ${deleted_days})
    OR (
      t.deleted_at IS NULL
      AND t.archived_at IS NOT NULL
      AND julianday('now') - julianday(t.archived_at) >= ${archived_days}
    )
    OR (
      t.deleted_at IS NULL
      AND t.archived_at IS NULL
      AND t.settled_at IS NOT NULL
      AND julianday('now') - julianday(t.settled_at) >= ${settled_days}
      AND julianday('now') - julianday(t.updated_at) >= ${settled_days}
    )
  )
ORDER BY COALESCE(t.deleted_at, t.archived_at, t.settled_at), t.thread_id;
SQL

candidate_count=0
removed_count=0
failed_count=0
skipped_count=0
archived_change_count=0

while IFS=$'\t' read -r thread_id worktree_path lifecycle lifecycle_at; do
  [ -n "$thread_id" ] || continue

  case "$thread_id" in
    *[!A-Za-z0-9._-]*)
      log "SKIP thread has an unsafe identifier: $thread_id"
      skipped_count=$((skipped_count + 1))
      continue
      ;;
  esac

  if [ ! -d "$worktree_path" ]; then
    continue
  fi
  candidate_count=$((candidate_count + 1))

  worktree_physical=$(cd "$worktree_path" && pwd -P)
  case "${worktree_physical}/" in
    "${worktree_root_physical}/"*) ;;
    *)
      log "SKIP ${thread_id} path escapes allowed root: $worktree_physical"
      skipped_count=$((skipped_count + 1))
      continue
      ;;
  esac

  if ! "$git_binary" -C "$worktree_physical" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log "SKIP ${thread_id} is not a Git worktree: $worktree_physical"
    skipped_count=$((skipped_count + 1))
    continue
  fi

  main_worktree=$(
    "$git_binary" -C "$worktree_physical" worktree list --porcelain \
      | sed -n 's/^worktree //p' \
      | head -n 1
  )
  if [ -z "$main_worktree" ] || [ ! -d "$main_worktree" ] || [ "$main_worktree" = "$worktree_physical" ]; then
    log "SKIP ${thread_id} cannot resolve a separate primary worktree"
    skipped_count=$((skipped_count + 1))
    continue
  fi

  git_dir=$("$git_binary" -C "$worktree_physical" rev-parse --git-dir)
  case "$git_dir" in
    /*) ;;
    *) git_dir="${worktree_physical}/${git_dir}" ;;
  esac
  if [ -e "${git_dir}/index.lock" ]; then
    log "SKIP ${thread_id} has an active Git index lock"
    skipped_count=$((skipped_count + 1))
    continue
  fi

  if "$ps_binary" -axo command= \
    | grep -F -- "${worktree_physical}/" \
    | grep -v -E '(^|/)(grep|t3-worktree-cleanup)( |$)' >/dev/null; then
    log "SKIP ${thread_id} has a process referencing its worktree"
    skipped_count=$((skipped_count + 1))
    continue
  fi

  still_eligible=$(
    "$sqlite_binary" -readonly "$database" <<SQL
SELECT COUNT(*)
FROM projection_threads AS t
LEFT JOIN projection_thread_sessions AS s ON s.thread_id = t.thread_id
LEFT JOIN provider_session_runtime AS r ON r.thread_id = t.thread_id
WHERE t.thread_id = '${thread_id}'
  AND t.pinned_at IS NULL
  AND t.pending_approval_count = 0
  AND t.pending_user_input_count = 0
  AND COALESCE(s.status, 'stopped') NOT IN ('running', 'starting')
  AND s.active_turn_id IS NULL
  AND COALESCE(r.status, 'stopped') NOT IN ('running', 'starting')
  AND (
    (t.deleted_at IS NOT NULL AND julianday('now') - julianday(t.deleted_at) >= ${deleted_days})
    OR (
      t.deleted_at IS NULL
      AND t.archived_at IS NOT NULL
      AND julianday('now') - julianday(t.archived_at) >= ${archived_days}
    )
    OR (
      t.deleted_at IS NULL
      AND t.archived_at IS NULL
      AND t.settled_at IS NOT NULL
      AND julianday('now') - julianday(t.settled_at) >= ${settled_days}
      AND julianday('now') - julianday(t.updated_at) >= ${settled_days}
    )
  );
SQL
  )
  if [ "$still_eligible" != "1" ]; then
    log "SKIP ${thread_id} became active or protected during cleanup"
    skipped_count=$((skipped_count + 1))
    continue
  fi

  status_output=$("$git_binary" -C "$worktree_physical" status --porcelain=v1 --untracked-files=all)
  dirty=false
  [ -n "$status_output" ] && dirty=true

  if [ "$mode" = "dry-run" ]; then
    log "DRY-RUN remove ${lifecycle} worktree thread=${thread_id} dirty=${dirty} since=${lifecycle_at} path=${worktree_physical}"
    continue
  fi

  timestamp=$(date -u '+%Y%m%dT%H%M%SZ')
  if ! "$git_binary" -C "$worktree_physical" symbolic-ref -q HEAD >/dev/null 2>&1; then
    head_ref="refs/t3-worktree-archive/${thread_id}/head-${timestamp}"
    head_oid=$("$git_binary" -C "$worktree_physical" rev-parse HEAD)
    "$git_binary" -C "$worktree_physical" update-ref "$head_ref" "$head_oid"
    "$git_binary" -C "$worktree_physical" cat-file -e "${head_ref}^{commit}"
    log "ARCHIVE ${thread_id} detached HEAD saved as ${head_ref}"
  fi

  if [ "$dirty" = true ]; then
    stash_before=$("$git_binary" -C "$worktree_physical" rev-parse -q --verify refs/stash 2>/dev/null || true)
    "$git_binary" -C "$worktree_physical" stash push --include-untracked \
      --message "t3-worktree-cleanup thread=${thread_id} lifecycle=${lifecycle} at=${timestamp}" >/dev/null
    stash_oid=$("$git_binary" -C "$worktree_physical" rev-parse -q --verify refs/stash 2>/dev/null || true)
    if [ -z "$stash_oid" ] || [ "$stash_oid" = "$stash_before" ]; then
      die "failed to create a recovery stash for ${thread_id}"
    fi
    archive_ref="refs/t3-worktree-archive/${thread_id}/stash-${timestamp}"
    "$git_binary" -C "$worktree_physical" update-ref "$archive_ref" "$stash_oid"
    "$git_binary" -C "$worktree_physical" cat-file -e "${archive_ref}^{commit}"
    if [ -n "$("$git_binary" -C "$worktree_physical" status --porcelain=v1 --untracked-files=all)" ]; then
      die "worktree remained dirty after archiving changes for ${thread_id}"
    fi
    archived_change_count=$((archived_change_count + 1))
    log "ARCHIVE ${thread_id} dirty changes saved as ${archive_ref}"
  fi

  if "$git_binary" -C "$main_worktree" worktree remove "$worktree_physical"; then
    "$git_binary" -C "$main_worktree" worktree prune
    removed_count=$((removed_count + 1))
    log "REMOVE ${thread_id} lifecycle=${lifecycle} path=${worktree_physical}"
  else
    log "ERROR Git refused to remove ${thread_id} at ${worktree_physical}" >&2
    failed_count=$((failed_count + 1))
  fi
done <"$candidate_file"

log "SUMMARY mode=${mode} candidates=${candidate_count} removed=${removed_count} failed=${failed_count} archived_changes=${archived_change_count} skipped=${skipped_count}"
[ "$failed_count" -eq 0 ] || exit 1

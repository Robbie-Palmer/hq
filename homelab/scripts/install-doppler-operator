#!/usr/bin/env bash
set -euo pipefail

expected_context=${REMOTE_DEVELOPMENT_KUBE_CONTEXT:-remote-development}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
operator_url=https://github.com/DopplerHQ/kubernetes-operator/releases/download/v1.7.1/recommended.yaml
operator_sha256=ef448ad54b37c122fff753fa3dfc5a218c13be9b67ff6866dc25dacea82b5f8c
operator_file=

cleanup() {
  if [ -n "${operator_file}" ]; then
    rm -f "${operator_file}"
  fi
}
trap cleanup EXIT

umask 077
operator_file=$(mktemp)

"${script_dir}/require-kube-context" "${expected_context}" cloud
curl --fail --location --silent --show-error "${operator_url}" --output "${operator_file}"
echo "${operator_sha256}  ${operator_file}" | sha256sum -c - >/dev/null
kubectl apply --server-side --filename "${operator_file}"
kubectl wait \
  --namespace doppler-operator-system \
  --for=condition=Available \
  --timeout=180s \
  deployment/doppler-operator-controller-manager

if [ "$#" -eq 0 ]; then
  set -- \
    "t3-code:doppler-token:homelab:prd_remote_development" \
    "t3-code:doppler-agent-token:personal-site:dev_agent" \
    "t3-code:doppler-work-graph-token:work-graph:prd_work_graph"
fi

for target in "$@"; do
  if [[ ${target} =~ ^([a-z0-9]([-a-z0-9]*[a-z0-9])?):([a-z0-9_]+)$ ]]; then
    namespace=${target%%:*}
    doppler_config=${target#*:}
    token_secret=doppler-token
    doppler_project=homelab
  elif [[ ${target} =~ ^([a-z0-9]([-a-z0-9]*[a-z0-9])?):([a-z0-9]([-a-z0-9]*[a-z0-9])?):([a-z0-9]([-a-z0-9]*[a-z0-9])?):([a-z0-9_]+)$ ]]; then
    IFS=: read -r namespace token_secret doppler_project doppler_config <<<"${target}"
  else
    echo "workspace secret target must be NAMESPACE:CONFIG or NAMESPACE:TOKEN_SECRET:PROJECT:CONFIG" >&2
    exit 1
  fi

  if ! kubectl get namespace "${namespace}" >/dev/null 2>&1; then
    kubectl create namespace "${namespace}"
  fi

  if kubectl --namespace "${namespace}" get secret "${token_secret}" >/dev/null 2>&1 \
    && [ "${ROTATE_DOPPLER_TOKEN:-0}" != "1" ]; then
    echo "Doppler service token ${namespace}/${token_secret} already exists"
    continue
  fi

  doppler configs tokens create "remote-development-k3s-${namespace}-${token_secret}-${doppler_config}" \
    --project "${doppler_project}" \
    --config "${doppler_config}" \
    --access read \
    --plain \
    | tr -d '\r\n' \
    | kubectl --namespace "${namespace}" create secret generic "${token_secret}" \
      --from-file=serviceToken=/dev/stdin \
      --dry-run=client \
      --output=yaml \
    | kubectl apply --filename -

  echo "Doppler service token ${namespace}/${token_secret} is ready"
done

echo "Doppler operator and requested namespace-scoped service tokens are ready"

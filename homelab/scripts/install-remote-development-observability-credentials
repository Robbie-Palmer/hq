#!/usr/bin/env bash
set -euo pipefail

target=${REMOTE_DEVELOPMENT_TAILNET_TARGET:-root@remote-development}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
doppler_project=${DOPPLER_REMOTE_DEVELOPMENT_OBSERVABILITY_PROJECT:-homelab}
doppler_config=${DOPPLER_REMOTE_DEVELOPMENT_OBSERVABILITY_CONFIG:-prd_remote_development_observability}

for command in doppler ssh; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "${command} is required to install observability credentials" >&2
    exit 1
  fi
done

# shellcheck source=remote-development-ssh
source "${script_dir}/remote-development-ssh"
remote_development_prepare_ssh "${target}"

temporary_directory=$(mktemp -d)
netdata_file=${temporary_directory}/netdata.env
healthchecks_file=${temporary_directory}/healthchecks.env
cleanup() {
  if command -v shred >/dev/null 2>&1; then
    shred --remove "${netdata_file}" "${healthchecks_file}" 2>/dev/null || true
  else
    rm -f -- "${netdata_file}" "${healthchecks_file}"
  fi
  rmdir "${temporary_directory}" 2>/dev/null || true
}
trap cleanup EXIT
umask 077

read_secret() {
  doppler secrets get "$1" \
    --project "${doppler_project}" \
    --config "${doppler_config}" \
    --plain
}

slack_webhook_url=$(read_secret NETDATA_SLACK_WEBHOOK_URL)
healthchecks_ping_url=$(read_secret HEALTHCHECKS_PING_URL)

if [[ ! ${slack_webhook_url} =~ ^https://hooks\.slack\.com/services/[A-Za-z0-9/_-]+$ ]]; then
  echo "NETDATA_SLACK_WEBHOOK_URL is not a Slack incoming webhook URL" >&2
  exit 1
fi
if [[ ! ${healthchecks_ping_url} =~ ^https://hc-ping\.com/[A-Za-z0-9_-]+/?$ ]]; then
  echo "HEALTHCHECKS_PING_URL is not a Healthchecks.io ping URL" >&2
  exit 1
fi

printf 'NETDATA_SLACK_WEBHOOK_URL=%s\n' "${slack_webhook_url}" >"${netdata_file}"
printf 'HEALTHCHECKS_PING_URL=%s\n' "${healthchecks_ping_url}" >"${healthchecks_file}"

ssh "${REMOTE_DEVELOPMENT_SSH_OPTIONS[@]}" "${target}" \
  'install -d -m 0700 /var/lib/remote-development-observability && install -m 0600 /dev/stdin /var/lib/remote-development-observability/netdata.env' \
  <"${netdata_file}"
ssh "${REMOTE_DEVELOPMENT_SSH_OPTIONS[@]}" "${target}" \
  'install -m 0600 /dev/stdin /var/lib/remote-development-observability/healthchecks.env' \
  <"${healthchecks_file}"
ssh "${REMOTE_DEVELOPMENT_SSH_OPTIONS[@]}" "${target}" \
  'systemctl restart netdata.service && systemctl start remote-development-healthcheck-heartbeat.service'

echo "observability credentials installed and services refreshed on ${target}"

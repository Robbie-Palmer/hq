#!/usr/bin/env bash
set -euo pipefail

image=ghcr.io/robbie-palmer/t3-code:0.0.38-agent-tools-12
target=${REMOTE_DEVELOPMENT_TAILNET_TARGET:-root@remote-development}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

source "${script_dir}/remote-development-ssh"
remote_development_prepare_ssh "${target}"

for command in docker gzip ssh; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "${command} is required" >&2
    exit 1
  fi
done

docker image inspect "${image}" >/dev/null

docker save "${image}" \
  | gzip --fast \
  | ssh "${REMOTE_DEVELOPMENT_SSH_OPTIONS[@]}" "${target}" '
      set -euo pipefail
      test "$(hostname)" = remote-development
      test "$(k3s kubectl get node remote-development --output=jsonpath='"'"'{.metadata.labels.homelab\.dev/location}'"'"')" = cloud
      gzip --decompress --stdout | k3s ctr images import -
    '

ssh "${REMOTE_DEVELOPMENT_SSH_OPTIONS[@]}" "${target}" \
  "k3s ctr images list name=='${image}' | grep -F '${image}' >/dev/null"

echo "loaded ${image} into remote-development K3s"

#!/usr/bin/env bash
set -euo pipefail

image=ghcr.io/robbie-palmer/t3-code:0.0.38-agent-tools-11
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
mise_version="$(<"${script_dir}/../../.github/actions/setup-mise/mise-version")"
container="personal-site-t3-image-check-$$"
docker_container="personal-site-rootless-docker-check-$$"
docker_data_volume="personal-site-rootless-docker-data-check-$$"
docker_image=docker:29.8.0-dind-rootless@sha256:e17fa54c2ffd511d8407c746eec77f7814e6f74fe20caf822dad1870599984c0

cleanup() {
  docker rm --force "${container}" >/dev/null 2>&1 || true
  docker rm --force "${docker_container}" >/dev/null 2>&1 || true
  docker volume rm "${docker_data_volume}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker run --rm \
  --tmpfs /data:rw,exec,uid=2000,gid=2000,mode=0750,size=1g \
  --env "EXPECTED_MISE_VERSION=${mise_version}" \
  --entrypoint /bin/sh \
  "${image}" \
  -ec '
    test "$(id -u)" = 2000
    test "$(id -g)" = 2000
    test "$(codex --version)" = "codex-cli 0.153.4"
    test "$(claude --version)" = "2.1.263 (Claude Code)"
    test "$(opencode --version)" = "1.18.29"
    test "$(grok --version | cut -d" " -f1-2)" = "grok 1.0.22"
    test "$(mise --version | cut -d" " -f1)" = "$EXPECTED_MISE_VERSION"
    test "$(doppler --version)" = "v3.76.5"
    test "$(vale --version)" = "vale version 3.19.0"
    test "$(pnpm --version)" = "12.4.1"
    test "$MISE_TRUSTED_CONFIG_PATHS" = "/data/workspaces:/data/home/.t3/worktrees"
    test "$(docker --version)" = "Docker version 29.8.0, build 88096ef"
    test "$(docker buildx version | cut -d" " -f1-3)" = "github.com/docker/buildx v0.37.0 ac30b249211430b85fb8f37b6e7154b5c47ba0b6"
    test "$(docker compose version)" = "Docker Compose version v5.5.1"
    case ":$PATH:" in
      *:/usr/local/lib/t3-code/node_modules/.bin:*) exit 1 ;;
    esac
    for cli in claude codex grok opencode pnpm t3; do
      test "$(command -v "$cli")" = "/usr/local/bin/$cli"
    done
    command -v bwrap chromium git gh lsof t3 >/dev/null
    test "$PUPPETEER_EXECUTABLE_PATH" = /usr/bin/chromium
    test "$PLAYWRIGHT_BROWSERS_PATH" = /data/home/.cache/ms-playwright
    mkdir -p /data/home/.t3/worktrees/mise-trust-check
    printf "%s\n" "[tasks.ready]" "run = \"true\"" \
      > /data/home/.t3/worktrees/mise-trust-check/.mise.toml
    (cd /data/home/.t3/worktrees/mise-trust-check && mise run ready)
    mkdir -p /data/home/.t3/userdata
    printf "%s\n" \
      "{\"providerInstances\":{\"codex-personal\":{\"accentColor\":\"#123456\",\"config\":{\"launchArgs\":\"--legacy\"}}}}" \
      > /data/home/.t3/userdata/settings.json
    node /usr/local/lib/t3-code/bootstrap-settings.mjs
    node -e '\''
      const settings = require("/data/home/.t3/userdata/settings.json");
      if (!settings.providers.grok.enabled) process.exit(1);
      if (!settings.providers.opencode.enabled) process.exit(1);
      const codex2 = settings.providerInstances.codex2;
      if ("codex-personal" in settings.providerInstances) process.exit(1);
      if (codex2.driver !== "codex") process.exit(1);
      if (codex2.displayName !== "codex2") process.exit(1);
      if (!codex2.enabled) process.exit(1);
      if (codex2.accentColor !== "#123456") process.exit(1);
      if (codex2.config.homePath !== "/data/home/.codex") process.exit(1);
      if (codex2.config.shadowHomePath !== "/data/home/.codex-personal") process.exit(1);
      if (codex2.config.launchArgs !== "--legacy") process.exit(1);
    '\''
    timeout 30 chromium \
      --headless \
      --no-sandbox \
      --disable-dev-shm-usage \
      --dump-dom "data:text/html,<title>browser-ready</title>" \
      2>/dev/null \
      | grep -F browser-ready >/dev/null
  '

docker run --detach \
  --name "${container}" \
  --tmpfs /data:rw,exec,uid=2000,gid=2000,mode=0750,size=1g \
  --publish 127.0.0.1::3773 \
  "${image}" >/dev/null

port=$(docker port "${container}" 3773/tcp | sed 's/.*://')
server_ready=false
for _ in $(seq 1 90); do
  if curl --fail --max-time 2 --silent "http://127.0.0.1:${port}/" >/dev/null; then
    server_ready=true
    break
  fi
  sleep 1
done

if [ "${server_ready}" != true ]; then
  echo "t3-code image did not become healthy" >&2
  exit 1
fi
echo "t3-code image starts as UID/GID 2000 and serves HTTP"
docker stop "${container}" >/dev/null 2>&1 || true

docker volume create "${docker_data_volume}" >/dev/null
docker run --rm \
  --user 0:0 \
  --volume "${docker_data_volume}:/data" \
  --entrypoint /bin/sh \
  "${docker_image}" \
  -eu -c 'chown 1000:2000 /data; chmod 2770 /data'

docker run --detach \
  --name "${docker_container}" \
  --privileged \
  --user 1000:1000 \
  --group-add 2000 \
  --env 'DOCKERD_ROOTLESS_ROOTLESSKIT_FLAGS=-p 127.0.0.1:2375:2375/tcp' \
  --volume "${docker_data_volume}:/home/rootless/.local/share/docker" \
  "${docker_image}" \
  dockerd \
  --host=tcp://0.0.0.0:2375 \
  --tls=false >/dev/null

docker_ready=false
for _ in $(seq 1 90); do
  if docker run --rm \
    --network "container:${docker_container}" \
    --user 2000:2000 \
    --env DOCKER_HOST=tcp://127.0.0.1:2375 \
    --entrypoint /bin/sh \
    "${image}" \
    -eu -c \
    'docker info >/dev/null && docker run --rm alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40 echo rootless-docker-ready' \
    >/dev/null 2>&1; then
    docker_ready=true
    break
  fi
  sleep 1
done

if [ "${docker_ready}" != true ]; then
  docker logs "${docker_container}" >&2
  echo "rootless Docker sidecar did not become healthy" >&2
  exit 1
fi
echo "t3-code image runs containers through the rootless Docker sidecar"

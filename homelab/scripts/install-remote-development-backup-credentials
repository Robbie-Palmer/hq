#!/usr/bin/env bash
set -euo pipefail

target=${REMOTE_DEVELOPMENT_TAILNET_TARGET:-root@remote-development}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
inventory_file=${REMOTE_DEVELOPMENT_BACKUP_INVENTORY:-${script_dir}/../remote-development-backup/inventory.json}
doppler_project=${DOPPLER_REMOTE_DEVELOPMENT_BACKUP_PROJECT:-homelab}
doppler_config=${DOPPLER_REMOTE_DEVELOPMENT_BACKUP_CONFIG:-prd_remote_development_backup}

for command in doppler jq ssh; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "${command} is required to install workspace backup credentials" >&2
    exit 1
  fi
done
if [ ! -r "${inventory_file}" ]; then
  echo "workspace backup inventory is not readable" >&2
  exit 1
fi

# shellcheck source=remote-development-ssh
source "${script_dir}/remote-development-ssh"
remote_development_prepare_ssh "${target}"

temporary_directory=$(mktemp -d)
credentials_file=${temporary_directory}/restic.env
password_file=${temporary_directory}/restic-password
cleanup() {
  if command -v shred >/dev/null 2>&1; then
    shred --remove "${credentials_file}" "${password_file}" 2>/dev/null || true
  else
    rm -f -- "${credentials_file}" "${password_file}"
  fi
  rmdir "${temporary_directory}" 2>/dev/null || true
}
trap cleanup EXIT
umask 077

read_secret() {
  doppler secrets get "$1" \
    --project "${doppler_project}" \
    --config "${doppler_config}" \
    --plain
}

account_id=$(read_secret CLOUDFLARE_ACCOUNT_ID)
access_key_id=$(read_secret R2_ACCESS_KEY_ID)
secret_access_key=$(read_secret R2_SECRET_ACCESS_KEY)
restic_password=$(read_secret RESTIC_PASSWORD)
bucket=$(jq --raw-output '.destination.bucket' "${inventory_file}")
prefix=$(jq --raw-output '.destination.repositoryPrefix' "${inventory_file}")

if [[ ! ${account_id} =~ ^[0-9a-f]{32}$ ]]; then
  echo "CLOUDFLARE_ACCOUNT_ID is invalid" >&2
  exit 1
fi
if [[ ! ${access_key_id} =~ ^[0-9a-f]{32}$ ]]; then
  echo "R2_ACCESS_KEY_ID is invalid" >&2
  exit 1
fi
if [ -z "${secret_access_key}" ] || [ -z "${restic_password}" ]; then
  echo "workspace backup credentials must not be empty" >&2
  exit 1
fi

printf '%s\n' \
  "AWS_ACCESS_KEY_ID=${access_key_id}" \
  "AWS_SECRET_ACCESS_KEY=${secret_access_key}" \
  "AWS_DEFAULT_REGION=auto" \
  "RESTIC_REPOSITORY=s3:https://${account_id}.r2.cloudflarestorage.com/${bucket}/${prefix}" \
  >"${credentials_file}"
printf '%s\n' "${restic_password}" >"${password_file}"

ssh "${REMOTE_DEVELOPMENT_SSH_OPTIONS[@]}" "${target}" \
  'install -d -m 0700 /var/lib/remote-development-backup && install -m 0600 /dev/stdin /var/lib/remote-development-backup/restic.env' \
  <"${credentials_file}"
ssh "${REMOTE_DEVELOPMENT_SSH_OPTIONS[@]}" "${target}" \
  'install -m 0600 /dev/stdin /var/lib/remote-development-backup/restic-password' \
  <"${password_file}"

echo "workspace backup credentials installed on ${target}"

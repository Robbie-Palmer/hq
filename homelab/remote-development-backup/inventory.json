{
  "schemaVersion": 1,
  "workspace": {
    "id": "operator",
    "owner": "robbie",
    "source": "/srv/remote-development/t3-code",
    "rebuildableCache": "/srv/remote-development/t3-code-cache"
  },
  "destination": {
    "provider": "cloudflare-r2",
    "bucket": "remote-development-workspace-backups",
    "repositoryPrefix": "restic/operator",
    "credentialsFile": "/var/lib/remote-development-backup/restic.env",
    "passwordFile": "/var/lib/remote-development-backup/restic-password"
  },
  "schedule": {
    "onCalendar": "*-*-* 00,06,12,18:17:00 UTC",
    "randomizedDelaySeconds": 900,
    "maximumAgeSeconds": 28800
  },
  "integrity": {
    "readDataSubset": "1%"
  },
  "retention": {
    "within": "14d",
    "minimumSnapshots": 8
  }
}

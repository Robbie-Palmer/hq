{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "plugins": ["jsx-a11y"],
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "jsx-a11y": {
      "components": {
        "Image": "img",
        "Input": "input",
        "Link": "a",
        "RecipePageLink": "a",
        "Textarea": "textarea"
      }
    }
  },
  "ignorePatterns": [
    "content/projects/recipe-site/designs/**",
    "e2e/**",
    "app/_projects/**/tests/**",
    "tests/**"
  ],
  "rules": {
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/anchor-ambiguous-text": "error",
    "jsx-a11y/lang": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": ["not-prose", "toaster"]
      }
    ],
    "shadcn/require-static-classes": "error"
  },
  "overrides": [
    {
      "files": [
        "app/(site)/ideas/page.tsx",
        "app/(site)/projects/**/adrs/**/page.tsx",
        "app/satellite-swarm/**",
        "components/experience/experience-card.tsx",
        "components/projects/satellite-swarm/**",
        "components/technology/cesium/**",
        "components/ui/tech-icon-orbit.tsx",
        "app/_projects/personal-finance-app/components/**"
      ],
      "rules": {
        "shadcn/no-raw-colors": "off"
      }
    },
    {
      "files": ["components/projects/pitch-deck/**"],
      "rules": {
        "shadcn/no-unknown-classes": "off"
      }
    },
    {
      "files": [
        "app/_projects/wedding-planner/components/**",
        "app/_projects/wedding-planner/routes/**",
        "app/wedding-planner/**"
      ],
      "rules": {
        "shadcn/no-unknown-classes": "off"
      }
    },
    {
      "files": ["app/recipes/**", "components/recipes/**"],
      "rules": {
        "shadcn/no-raw-colors": [
          "error",
          {
            "message": "Use a recipe color token from app/recipes/recipe-theme.css instead of {{className}}."
          }
        ],
        "shadcn/no-unknown-classes": [
          "error",
          {
            "allow": ["recipe-*", "rt-*"],
            "message": "Unknown recipe class {{className}}. Use Tailwind or declare it in app/recipes/recipe-theme.css."
          }
        ]
      }
    },
    {
      "files": [
        "components/initiatives/initiative-status-badge.tsx",
        "components/projects/adr-badge.tsx",
        "components/projects/project-status-badge.tsx",
        "components/ui/**"
      ],
      "rules": {
        "shadcn/require-static-classes": "off"
      }
    }
  ]
}

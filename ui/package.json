    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-fullscreen": "^1.0.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "chrome-launcher": "^1.2.1",
    "cloudflare": "^7.0.0",
    "jsdom": "^29.0.0",
    "lighthouse": "^13.0.1",
    "node-base": "workspace:*",
    "oxlint": "^1.85.0",

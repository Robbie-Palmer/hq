{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/generate-typos-dictionary.ts && node scripts/copy-cesium-assets.mjs",
    "prebuild": "node scripts/copy-cesium-assets.mjs",
    "dev": "next dev --turbopack",
    "dev:qr": "node scripts/qr-dev.mjs && pnpm run dev",
    "build": "next build && node scripts/check-static-javascript.mjs && tsx scripts/generate-typos-dictionary.ts --out out/recipes && tsx scripts/generate-agent-markdown.ts && tsx scripts/generate-rss.ts",
    "audit:satellite-swarm": "node e2e/projects/satellite-swarm/audit.mjs",
    "generate:agent-markdown": "tsx scripts/generate-agent-markdown.ts",
    "generate:rss": "tsx scripts/generate-rss.ts",
    "generate:typos-dictionary": "tsx scripts/generate-typos-dictionary.ts",
    "start": "next start",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:coverage": "UI_COVERAGE=true vitest run --coverage --exclude 'ui/tests/integration/**'",
    "test:e2e:mermaid": "playwright test --config playwright.mermaid.config.ts",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "test:integration": "vitest run --no-file-parallelism tests/integration",
    "test:watch": "vitest --exclude 'tests/integration/**'",
    "lint": "biome check && oxlint",
    "lint:design": "oxlint",
    "format": "biome check --write --no-errors-on-unmatched",
    "format:check": "biome check",
    "typecheck": "tsc --noEmit",
    "images:sync": "./scripts/images-sync.ts",
    "images:health-check": "./scripts/images-health-check.ts",
    "lighthouse": "LIGHTHOUSE_DEVICE=both node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@cooklang/cooklang": "^0.18.0",
    "@cosmos.gl/graph": "^3.4.1",
    "@posthog/brand": "0.12.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@revealjs/react": "0.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.21",
    "better-auth": "^1.6.19",
    "browser-base": "workspace:*",
    "cesium": "^1.145.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "feed": "^6.0.0",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "leaflet-fullscreen": "^1.0.2",
    "lucide-react": "^0.577.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.0.0",
    "motion": "^12.23.26",
    "next": "^15.5.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.343.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-responsive": "^10.0.1",
    "reading-time": "^1.5.0",
    "recharts": "^3.3.0",

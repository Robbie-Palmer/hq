    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "reveal.js": "6.0.2",
    "shiki": "^4.0.0",
    "simple-icons": "^16.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "ts-base": "workspace:*",
    "vaul": "^1.1.2",
    "yaml": "2.9.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
